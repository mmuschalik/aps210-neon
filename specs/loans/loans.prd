// Prudence source: loans - contractual inflows within 30 days (LCR) and
// required stable funding by residual maturity of each repayment (NSFR).
//
// Contracts follow ACTUS: ANN (annuity: a level payment, `payment`, covering
// interest and principal), LAM (linear amortizer: fixed principal per period
// plus interest), PAM (principal at maturity, periodic interest) and UMP
// (open maturity: revolving credit, overdrafts, cards). Interest accrues per
// period at rate x cycle / 12 (30E/360) on the balance outstanding.

@standard("APS 210", version: "2025-07-01", clause: "Att A paras 54, 60-62 (inflows); Att C paras 21-23, 33-36 (RSF)")
@reporting("ARS 210.0", version: "2023-03-31", clause: "ARF 210.1A item 20; ARF 210.6 items 24, 35-37, 39")
module Loans(jurisdiction: AU_APRA) {

  param reporting_date : Date

  type Borrower = RetailCustomer | Sme | NonFinancialCorporate | CentralBank | FinancialInstitution | OtherEntity
  type Product = ResidentialMortgage | OtherLoan

  data Loan : Contract<ANN(payment: Money<AUD, Carrying>)
                     | LAM(principal_per_period: Money<AUD, Carrying>)
                     | PAM(maturity: Date)
                     | UMP(minimum_payment: Money<AUD, Carrying>)> {
    borrower     : Borrower
    product      : Product
    balance      : Money<AUD, Carrying>
    rate         : Rate                               // nominal annual rate
    next_payment : Date                               // ACTUS anchor of the payment cycle
    cycle_months : Int
    // Fully performing, no reason to expect a default within 30 days.
    //                                                  Conservative: false
    performing   : Uncertain<Bool>                    @cite("Att A para 54")
    // Standard residential mortgage with LVR <= 80% (Att C para 35(a)); or
    // another loan with a risk weight <= 35% (Att C para 35(b)).
    lvr_at_most_80 : Uncertain<Bool>
    risk_weight    : Int
    // Pledged (e.g. covered bond pool, repo of self-securitised notes) until.
    encumbered_until : Option<Date>                   @cite("Att C para 23")
  }

  // ---------------------------------------------------------------- schedule

  fn period_rate(l: Loan) -> Rate = l.rate * l.cycle_months / 12

  // The balance after the first n scheduled payments.
  fn outstanding(l: Loan, n: Int) -> Money<AUD, Carrying> =
    match l.contract {
      LAM(p) => max(0.AUD, l.balance - p * n)
      ANN(a) =>
        let g = 1 + period_rate(l)
        if period_rate(l) == 0 then max(0.AUD, l.balance - a * n)
        else max(0.AUD, l.balance * pow(g, n) - a * (pow(g, n) - 1) / period_rate(l))
      PAM(maturity) => if n >= 1 && add_months(l.next_payment, (n - 1) * l.cycle_months) >= maturity then 0.AUD else l.balance
      UMP(m) => l.balance
    }

  // Payment k (0-based): principal repaid plus interest on what was outstanding.
  fn cash(l: Loan, k: Int) -> Money<AUD, Carrying> =
    match l.contract {
      UMP(m) => if k == 0 then min(m, l.balance) else 0.AUD
      _      => outstanding(l, k) - outstanding(l, k + 1) + outstanding(l, k) * period_rate(l)
    }

  fn last_payment_day(l: Loan) -> Date =
    match l.contract {
      PAM(maturity) => maturity
      _             => reporting_date + 36500.days
    }

  // Contractual cash in the next 30 days: open-maturity loans only their
  // minimum payment; nothing from loans that are not fully performing.
  fn inflow_30d(l: Loan) -> Money<AUD, Carrying> =
    if !conservative(l.performing, worst: false) then 0.AUD
    else sum(k in cycle(l.next_payment, l.cycle_months, min(reporting_date + 30.days, last_payment_day(l))) | cash(l, k))
                                                                         @cite("Att A paras 54, 60")

  fn inflow_row(l: Loan) -> String =
    match l.borrower {
      RetailCustomer        => "20.1"
      Sme                   => "20.2"
      NonFinancialCorporate => "20.3"
      CentralBank           => "20.4"
      FinancialInstitution  => "20.5"
      OtherEntity           => "20.6"
    }                                                                    @cite("Att A paras 61-62")

  fn inflow(l: Loan, i: String) -> Money<AUD, Carrying> =
    if i == inflow_row(l) then inflow_30d(l) else 0.AUD

  // Principal falling due before date t (exclusive). An annuity whose
  // payment does not cover the interest amortizes negatively: its balance
  // grows and no principal falls due (the payment is still an inflow).
  fn principal_before(l: Loan, t: Date) -> Money<AUD, Carrying> =
    match l.contract {
      UMP(m) => 0.AUD
      _      => max(0.AUD, l.balance - outstanding(l, sum(k in cycle(l.next_payment, l.cycle_months, t - 1.days) | 1)))
    }

  // ---------------------------------------------------------------- NSFR

  fn rsf_item(l: Loan) -> String =
    if !conservative(l.performing, worst: false) then "39"
    else if l.borrower == FinancialInstitution || l.borrower == CentralBank then "24"
    else if l.product == ResidentialMortgage && conservative(l.lvr_at_most_80, worst: false) then "35"
    else if l.risk_weight <= 35 then "36"
    else "37"                                                            @cite("Att C paras 33-36")

  // Encumbered for a year or more: 100% whatever the maturity (Att C para 23).
  // An expired encumbrance (or none) leaves the loan unencumbered.
  fn sub_item(l: Loan) -> String =
    if rsf_item(l) == "39" then "39"
    // Loans to FIs split encumbrance into < 6m, 6-12m, >= 1y (24.2.1-24.2.3).
    else if rsf_item(l) == "24" then
      (if l.encumbered_until >= add_months(reporting_date, 12) then "24.2.3"
       else if l.encumbered_until >= add_months(reporting_date, 6) then "24.2.2"
       else if l.encumbered_until > reporting_date then "24.2.1"
       else "24.1")
    // Less than six months of encumbrance left: as if unencumbered.
    else if l.encumbered_until >= add_months(reporting_date, 12) then item(item(rsf_item(l), 2), 2)
    else if l.encumbered_until >= add_months(reporting_date, 6) then item(item(rsf_item(l), 2), 1)
    else item(rsf_item(l), 1)                                            @cite("Att C para 23")

  // Each repayment is bucketed by its own date: < 6 months, 6-12 months,
  // >= 1 year (Att C para 22); open maturity: >= 1 year (Att C para 21).
  partition l: Loan into Arf210_6
      splitting l.balance by within_6m: principal_before(l, add_months(reporting_date, 6)),
                              within_1y: (if within_6m then 0.AUD
                                          else principal_before(l, add_months(reporting_date, 12))
                                               - principal_before(l, add_months(reporting_date, 6))) {
    case within_6m =>
      nsfr: (sub_item(l), "b0")
    case !within_6m && within_1y =>
      nsfr: (sub_item(l), "b1")
    case !within_6m && !within_1y =>
      nsfr: (sub_item(l), "b2")
  }
}
