// Prudence source: debt securities issued, regulatory capital, and deposits
// placed with other ADIs.

@standard("APS 210", version: "2025-07-01", clause: "Att A Table 3, paras 61-63; Att C paras 11, 33-34")
@reporting("ARS 210.0", version: "2023-03-31", clause: "ARF 210.1A items 10, 12.1, 20.5; ARF 210.6 items 1, 12, 24, 33; ARF 210.2 item 6")
@effective(from: "2025-07-01")
module FundingAndPlacements(jurisdiction: AU_APRA) {

  param reporting_date : Date

  type SecurityKind = ShortTerm | EuroCommercialPaper | UsCommercialPaper | LongTerm
                    | CoveredBond | ShortTermSecuritisation | LongTermSecuritisation
  type Tier = CET1 | AT1 | T2
  type AdiType = MajorBank | LcrAdi | OtherAdi | ForeignAdi

  // A debt security issued by the ADI (carrying amount; holder not traceable).
  data IssuedSecurity {
    kind     : SecurityKind
    amount   : Money<AUD, Carrying>
    maturity : Date
    offshore : Bool
  }

  data CapitalInstrument {
    tier     : Tier
    amount   : Money<AUD, Carrying>
    maturity : Option<Date>                        // none: perpetual
  }

  // A deposit placed with another ADI.
  data Placement {
    adi         : AdiType
    amount      : Money<AUD, Carrying>
    maturity    : Option<Date>                     // none: on call
    // Held for clearing, custody or cash management. Conservative: true
    // (no inflow, the higher RSF factor).
    operational : Uncertain<Bool>                  @cite("Att A para 63; Att C para 34(d)")
  }

  fn within_30(d: Date) -> Bool = days(reporting_date, d) <= 30

  // ---------------------------------------------------------------- issued securities

  fn secured(s: IssuedSecurity) -> Bool =
    s.kind in [CoveredBond, ShortTermSecuritisation, LongTermSecuritisation]

  fn security_lcr_row(s: IssuedSecurity) -> String =
    if !within_30(s.maturity) then "none"
    else if secured(s) then "12.1"                                        @cite("Att A Table 3: maturing secured funding issued by the ADI, 100%")
    else if s.offshore then "10.2" else "10.1"                            @cite("Att A Table 3: unsecured debt maturing within 30 days, 100%")

  // Tradable instruments whose holder cannot be traced: ARF 210.6 item 12.
  fn security_nsfr_item(s: IssuedSecurity) -> String = "12"               @cite("ARS Instructions p.148, item 12")

  fn security_bucket(s: IssuedSecurity) -> String = bucket(s.maturity)

  // ---------------------------------------------------------------- capital

  fn capital_lcr_row(c: CapitalInstrument) -> String =
    if c.tier == T2 && c.maturity <= reporting_date + 30.days then "10.1" else "none"

  // Tier 1 and Tier 2 capital, excluding Tier 2 with residual maturity under
  // one year (Att C para 11(a); ARS item 1): that part is term funding.
  fn capital_nsfr_item(c: CapitalInstrument) -> String =
    if c.tier == T2 && c.maturity < add_months(reporting_date, 12) then "12" else "1"
                                                                          @cite("ARS Instructions p.147, item 1")

  fn capital_bucket(c: CapitalInstrument) -> String =
    if capital_nsfr_item(c) == "1" then "b2"
    else if let Some(m) = c.maturity then bucket(m) else "b2"

  // ---------------------------------------------------------------- placements

  fn operational(p: Placement) -> Bool = conservative(p.operational, worst: true)

  fn placement_lcr_row(p: Placement) -> String =
    if operational(p) then "none"                                         @cite("Att A para 63: 0% inflow")
    else if p.maturity == none || p.maturity <= reporting_date + 30.days then "20.5"
    else "none"                                                           @cite("Att A para 62: financial institutions, 100%")

  fn placement_nsfr_item(p: Placement) -> String =
    if operational(p) then "33.1" else "24.1"                            @cite("Att C paras 33(b), 34(d)")

  fn placement_bucket(p: Placement) -> String =
    if let Some(m) = p.maturity then bucket(m) else "b0"

  fn placement_mlh_row(p: Placement) -> String =
    item(if p.maturity == none then "6.1" else "6.2",
         match p.adi {
           MajorBank  => 1
           LcrAdi     => 2
           OtherAdi   => 3
           ForeignAdi => 4
         })                                                               @cite("ARF 210.2 item 6")
}
