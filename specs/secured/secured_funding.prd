// Prudence source: the stock of liquid assets, secured funding, secured
// lending and the 30-day unwind
// (design.txt §4.A.4 "Declarative Counterfactual Transitions").
//
// Two views of the same maturing transactions:
//   unwind(r, k)        - the financial physics: settle the transaction early,
//                         cash goes back, collateral comes back (Att A para 8);
//   contribution(r, i)  - APRA's bookkeeping: what r reports in ARF 210.1A
//                         item i (Section B item 11, Section C item 19).
// Theorem (proven in Lean on the generated model): for every portfolio, the
// unwind equals the ARF 210.1A adjustment formulas (items 1.5.1, 2.5.1,
// 3.4.1, 3.5.1) applied to the reported items.

@standard("APS 210", version: "2025-07-01", clause: "Att A paras 6-8, 22-25; Table 3; Table 4")
@reporting("ARS 210.0", version: "2023-03-31", clause: "ARF 210.1A items 1.5-3.6, 11, 19")
module SecuredFunding(jurisdiction: AU_APRA) {

  param reporting_date : Date
  param known_at       : Date = reporting_date
  // The ADI has a committed liquidity facility with the RBA approved for the LCR.
  param has_clf        : Bool = false                  @cite("Att A paras 13-20")

  type HqlaClass = HQLA1 | HQLA2A | RmbsHqla2B | NonRmbsHqla2B | ClfEligible | NonHqla
  type Leg = Funding | Lending
  type Counterparty = OffshoreCentralBank | DomesticSovereignOrPse | OtherCounterparty
  type AssetKind = NotesAndCoin | RbaBalance | ForeignCentralBankBalance | DebtSecurity | CoveredBond | Rmbs | Equity
  type Issuer = AustralianGovernment | StateCentralBorrowingAuthority | ForeignSovereign | GuaranteedByAustralianGovernment
              | GuaranteedByForeignSovereign | CentralBank | PublicSectorEntity | Supranational
              | NonFinancialCorporateIssuer | FinancialInstitutionIssuer
  type ClfCategory = SupranationalOrForeignGovernment | Guaranteed | AdiIssued | AssetBacked | OtherPrivate
                  | SelfSecuritised | NotClfEligible

  // A holding in the stock of liquid assets (Section A).
  data Holding {
    kind              : AssetKind
    issuer            : Issuer
    market_value      : Money<AUD, MarketValue>
    risk_weight       : Int                          @cite("APS 112 Attachment B")
    rating_grade      : Int                          @cite("APS 112 Attachment F; ARS 'credit rating grade'")
    domestic_currency : Bool                         // issued in the currency where the liquidity risk is taken
    index_constituent : Bool                         // equities: in the major index (Att A para 12(c))
    // Issued (or, for RMBS, the mortgages originated) by the ADI itself or an
    // associated entity.
    own_or_associated : Bool                         @cite("Att A paras 10(b), 12(a)")
    encumbered        : Bool                         // pledged, e.g. as repo collateral (Att A para 23)
    // Central bank balances: can be drawn down in times of stress.
    drawable_in_stress : Uncertain<Bool>            @cite("Att A para 9(b); ARS p.41")
    // CLF: RBA repo-eligible category, and value after the RBA margin.
    clf_category      : ClfCategory                  @cite("ARS items 6.1.1-6.1.6")
    value_after_rba_margin : Money<AUD, MarketValue>
    maturity          : Option<Date>
    operational       : Uncertain<Bool>              @cite("Att A paras 22-25")
  }

  // ACTUS REP (repurchase agreement): cash against collateral, unwound at maturity.
  data Repo : Contract<REP(maturity: Date)> {
    leg              : Leg                         // Funding: we received cash (repo); Lending: we extended it (reverse repo)
    cash             : Money<AUD, MarketValue>
    collateral_class : HqlaClass
    collateral_value : Money<AUD, MarketValue>
    counterparty     : Counterparty
    // The collateral meets (or would meet, if held unencumbered) the HQLA
    // operational requirements.                                  Conservative: false
    operational      : Uncertain<Bool>              @cite("Att A paras 22-25")
    // Received collateral re-used to cover short positions.
    rehypothecated   : Bool                         @cite("Att A para 56")
  }

  // ---------------------------------------------------------------- the stock (Section A)

  // ARF 210.1A Section A item of a holding, or "none" if it is not HQLA or
  // cannot be counted (encumbered, or the operational requirements are not
  // shown to be met).
  fn stock_row(h: Holding) -> String =
    if h.encumbered || !conservative(h.operational, worst: false) then "none"     @cite("Att A paras 22-25")
    else match h.kind {
      NotesAndCoin              => "1.1"
      RbaBalance                => if conservative(h.drawable_in_stress, worst: false) then "1.2.1" else "none"
      ForeignCentralBankBalance => if conservative(h.drawable_in_stress, worst: false) then "1.2.2" else "none"
      DebtSecurity =>
        if h.risk_weight == 0 then match h.issuer {
          AustralianGovernment             => "1.3.1"
          StateCentralBorrowingAuthority   => "1.3.2"
          ForeignSovereign                 => "1.3.3"
          GuaranteedByAustralianGovernment => "1.3.4"
          GuaranteedByForeignSovereign     => "1.3.5"
          CentralBank                      => "1.3.6"
          PublicSectorEntity               => "1.3.7"
          Supranational                    => "1.3.8"
          _                                => "none"
        }                                                                    @cite("Att A para 9(c)")
        else if (h.issuer == ForeignSovereign || h.issuer == CentralBank) && h.risk_weight > 20 then
          (if h.domestic_currency then "1.4.1" else "1.4.2")               @cite("Att A para 9(d)-(e)")
        else if h.risk_weight == 20 && (h.issuer == ForeignSovereign || h.issuer == CentralBank) then "2.1"
        else if h.risk_weight == 20 && (h.issuer == PublicSectorEntity || h.issuer == Supranational) then "2.2"
        else if h.issuer == NonFinancialCorporateIssuer && h.rating_grade == 1 then "2.3"     @cite("Att A para 10(b)")
        else if h.issuer == NonFinancialCorporateIssuer && h.rating_grade >= 2 && h.rating_grade <= 3 then "3.2"
                                                                             @cite("Att A para 12(b)")
        else "none"
      CoveredBond => if h.rating_grade == 1 && !h.own_or_associated then "2.4" else "none"    @cite("Att A para 10(b)")
      Rmbs        => if h.rating_grade == 1 && !h.own_or_associated then "3.1" else "none"    @cite("Att A para 12(a)")
      Equity      => if h.issuer == NonFinancialCorporateIssuer && h.index_constituent then "3.3" else "none"
    }

  fn stock(h: Holding, i: String) -> Money<AUD, MarketValue> =
    if i == stock_row(h) then h.market_value else 0.AUD

  // ---------------------------------------------------------------- the CLF (alternative liquid assets)

  // RBA repo-eligible securities that are not HQLA, held for the CLF.
  fn clf_row(h: Holding) -> String =
    if !has_clf || h.encumbered || !conservative(h.operational, worst: false) || stock_row(h) != "none" then "none"
    else match h.clf_category {
      SupranationalOrForeignGovernment => "6.1.1"
      Guaranteed                       => "6.1.2"
      AdiIssued                        => "6.1.3"
      AssetBacked                      => "6.1.4"
      OtherPrivate                     => "6.1.5"
      SelfSecuritised                  => "6.1.6"
      NotClfEligible                   => "none"
    }                                                                   @cite("Att A paras 15-16; ARS pp. 43-44")

  fn clf(h: Holding, i: String) -> Money<AUD, MarketValue> =
    (if i == clf_row(h) then h.value_after_rba_margin else 0.AUD)
    // Item 6.4: CLF securities maturing within 30 days (not counted again as inflows).
    + (if i == "6.4" && clf_row(h) != "none" && h.maturity <= reporting_date + 30.days
       then h.value_after_rba_margin else 0.AUD)                       @cite("APG 210 para 105; ARS p.44")

  // Everything a holding reports in Section A.
  fn section_a(h: Holding, i: String) -> Money<AUD, MarketValue> = stock(h, i) + clf(h, i)

  // Item 21.3: unencumbered securities outside the HQLA stock and the CLF
  // that mature within 30 days flow in at 100%.
  fn securities_inflow(h: Holding, i: String) -> Money<AUD, MarketValue> =
    if i == "21.3" && !h.encumbered && stock_row(h) == "none" && clf_row(h) == "none"
       && h.maturity <= reporting_date + 30.days
    then h.market_value else 0.AUD                                      @cite("Att A para 65; APG 210 para 105")

  // Everything a holding reports on ARF 210.1A.
  fn holding_items(h: Holding, i: String) -> Money<AUD, MarketValue> = section_a(h, i) + securities_inflow(h, i)

  // ---------------------------------------------------------------- facts about a transaction

  fn maturing(r: Repo) -> Bool =
    match r.contract {
      REP(maturity) => days(reporting_date, maturity) <= 30
    }                                                                   @cite("Att A para 8: up to and including 30 days")

  // The collateral would count in the HQLA stock: an HQLA class, operational,
  // and (for received collateral) not re-used.
  fn qualifies(r: Repo) -> Bool =
    r.collateral_class in [HQLA1, HQLA2A, RmbsHqla2B, NonRmbsHqla2B]
    && conservative(r.operational, worst: false)
    && !(r.leg == Lending && r.rehypothecated)                          @cite("Att A para 8; ARS items 11.x.1, 19.1.x.1")

  // ---------------------------------------------------------------- the financial physics

  // Change in the stock of class k from unwinding r (zero unless r matures
  // within 30 days and its collateral qualifies). Cash is HQLA1.
  fn unwind(r: Repo, k: HqlaClass) -> Money<AUD, MarketValue> =
    if !(maturing(r) && qualifies(r)) then 0.AUD
    else match r.leg {
      // Repo: return the cash, get the collateral back.
      Funding => (if k == r.collateral_class then r.collateral_value else 0.AUD)
                 - (if k == HQLA1 then r.cash else 0.AUD)
      // Reverse repo: get the cash back, return the collateral.
      Lending => (if k == HQLA1 then r.cash else 0.AUD)
                 - (if k == r.collateral_class then r.collateral_value else 0.AUD)
    }                                                                   @cite("Att A para 8")

  // ---------------------------------------------------------------- APRA's bookkeeping

  // Section B item 11 (secured funding) / Section C item 19 (secured lending).
  fn row(r: Repo) -> String =
    match r.leg {
      Funding => match r.counterparty {
        OffshoreCentralBank => "11.7"
        _ => match r.collateral_class {
          HQLA1         => "11.1"
          HQLA2A        => "11.2"
          RmbsHqla2B    => "11.3"
          NonRmbsHqla2B => "11.4"
          ClfEligible   => if has_clf then "11.5"
                           else if r.counterparty == DomesticSovereignOrPse then "11.6.1" else "11.6.2"
          NonHqla       => if r.counterparty == DomesticSovereignOrPse then "11.6.1" else "11.6.2"
        }
      }
      Lending => match r.collateral_class {
        HQLA1         => if r.rehypothecated then "19.2.1" else "19.1.1"
        HQLA2A        => if r.rehypothecated then "19.2.2" else "19.1.2"
        RmbsHqla2B    => if r.rehypothecated then "19.2.3" else "19.1.3"
        NonRmbsHqla2B => if r.rehypothecated then "19.2.4" else "19.1.4"
        ClfEligible   => if r.rehypothecated then "19.2.6" else if has_clf then "19.1.5" else "19.1.8"
        NonHqla       => if r.rehypothecated then "19.2.6" else "19.1.8"
      }
    }                                                                   @cite("ARS 210.0 pp. 48-50, 57-58")

  // "of which: transactions involving eligible HQLA" (cash amount).
  fn of_which_row(r: Repo) -> String =
    match (r.leg, r.counterparty, r.collateral_class) {
      (_, _, NonHqla)                                => "none"
      (_, _, ClfEligible)                            => "none"
      // Item 11.7 (offshore central banks) exists for funding only.
      (Funding, OffshoreCentralBank, HQLA1)          => "11.7.1"
      (Funding, OffshoreCentralBank, HQLA2A)         => "11.7.3"
      (Funding, OffshoreCentralBank, RmbsHqla2B)     => "11.7.5"
      (Funding, OffshoreCentralBank, NonRmbsHqla2B)  => "11.7.7"
      _                                              => item(row(r), 1)
    }

  // "market value of the collateral" for those transactions.
  fn collateral_row(r: Repo) -> String =
    match (r.leg, r.counterparty, r.collateral_class) {
      (_, _, NonHqla)                                => "none"
      (_, _, ClfEligible)                            => "none"
      // Item 11.7 (offshore central banks) exists for funding only.
      (Funding, OffshoreCentralBank, HQLA1)          => "11.7.2"
      (Funding, OffshoreCentralBank, HQLA2A)         => "11.7.4"
      (Funding, OffshoreCentralBank, RmbsHqla2B)     => "11.7.6"
      (Funding, OffshoreCentralBank, NonRmbsHqla2B)  => "11.7.8"
      _                                              => item(row(r), 2)
    }

  // CLF securities extended or received in secured transactions with CLF
  // capacity: items 11.5.1 / 19.1.5.1 (value after the RBA margin).
  fn clf_collateral_row(r: Repo) -> String =
    if r.collateral_class != ClfEligible || !has_clf || r.counterparty == OffshoreCentralBank then "none"
    else match r.leg {
      Funding => "11.5.1"
      Lending => if r.rehypothecated then "none" else "19.1.5.1"
    }                                                                   @cite("ARS pp. 49-50, 57")

  // What r reports in ARF 210.1A item `i` (column 1). Only transactions
  // maturing within 30 days are reported.
  fn contribution(r: Repo, i: String) -> Money<AUD, MarketValue> =
    if !maturing(r) then 0.AUD
    else (if i == row(r) then r.cash else 0.AUD)
       + (if qualifies(r) && i == of_which_row(r) then r.cash else 0.AUD)
       + (if qualifies(r) && i == collateral_row(r) then r.collateral_value else 0.AUD)
       + (if i == clf_collateral_row(r) then r.collateral_value else 0.AUD)
                                                                        @cite("ARS 210.0 pp. 48-50, 57-58")
}
