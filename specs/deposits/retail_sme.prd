// Prudence source for the step-2 deposit rules (syntax of design.txt §4.A).
// crates/deposits implements the same rules in Rust and is the executable
// reference until the Prudence interpreter runs this module.

@standard("APS 210", version: "2025-07-01", clause: "Att A §§34-46; Att C §§8, 12-14")
@guidance("APG 210", version: "2025-07", clause: "§§106-131, 164")
@reporting("ARS 210.0", version: "2023-03-31")
module RetailAndSmeDeposits(jurisdiction: AU_APRA) {

  param reporting_date : Date
  param known_at       : Date = reporting_date
  param fcs_limit      : Money<AUD, Carrying> = 250_000.AUD    @cite("APG 210 §109")
  param sme_threshold  : Money<AUD, Carrying> = 2_000_000.AUD  @cite("Att A §46(b)")

  // ---------------------------------------------------------------- data
  // Contracts are ACTUS types; events are bitemporal (valid, recorded).

  type Kind = NaturalPerson | Smsf | PersonalInvestmentEntity | Sme | NonFinancialCorporate | FinancialInstitution
  type Class = Retail | RetailLessStable | SmeRetail | NonFinancialCorporate | FinancialInstitution
  type WithdrawalTerms = NoLegalRight | SignificantPenalty | Permitted
  type Horizon = Demand | Called | Excluded
  type Stability = Stable | LessStable | HigherRunOff

  data Customer {
    kind                     : Kind
    established_relationship : Uncertain<Bool>     @cite("Att A §37(a); APG 210 §111")
    sme_group                : Uncertain<GroupId>  @cite("Att A §46(b)")
    managed_as_retail        : Uncertain<Bool>     @cite("Att A §46(a); APG 210 §130")
    pie_qualifies            : Uncertain<Bool>     @cite("APG 210 §119")
    deposits                 : List<Deposit>
  }

  data Deposit : Contract<UMP | CLM(notice_days: Int, grace_end: Option<Date>)
                         | PAM(maturity: Date, early_withdrawal: Uncertain<WithdrawalTerms>)> {
    holder        : Customer
    product_class : ProductClass
    balance       : Money<AUD, Carrying>
    fcs_eligible  : Uncertain<Bool>
    transactional : Uncertain<Bool>                @cite("APG 210 §112")
    online        : Uncertain<Bool>                @cite("APG 210 §116")
    rate_driven   : Uncertain<Bool>                @cite("APG 210 §117")
  }

  event NoticeGiven(deposit: Deposit, repayment: Date)
  event EarlyWithdrawal(product_class: ProductClass, hardship: Bool)

  // ---------------------------------------------------------------- views

  // Consolidated SME funding for the AUD 2m test (non-local rule). An unknown
  // group can't be shown to be under AUD 2m (worst: none, dropped from the
  // grouping); optimistically the SME is a group of one, `solo(holder)`.
  view SmeGroups =
    group Deposit by conservative(holder.sme_group, worst: none, best: solo(holder))
          where holder.kind == Sme {
      total = sum(balance)
    }

  // Att A §42: one non-hardship break taints the whole product category.
  view Tainted =
    distinct(e in events(as_of: reporting_date, known_at: known_at)
             where e is EarlyWithdrawal && !e.hardship | e.product_class)

  fn latest_notice(d: Deposit) -> Option<NoticeGiven> =
    latest(e in events(as_of: reporting_date, known_at: known_at)
           where e is NoticeGiven && e.deposit == d && e.repayment >= reporting_date | e)

  // ---------------------------------------------------------------- depositor class
  // `conservative(x, worst: v, best: b)` resolves an unknown to v (reported run)
  // or b (optimistic run; defaults to !v for booleans) and logs the assumption.
  // Where retail treatment needs evidence, "worst" is the treatment that applies
  // without that evidence - not necessarily the higher run-off (see theorems).

  fn class(c: Customer) -> Class =
    match c.kind {
      NaturalPerson            => Retail                                   @cite("Att A §34")
      Smsf                     => RetailLessStable                         @cite("APG 210 §118")
      PersonalInvestmentEntity =>
        if conservative(c.pie_qualifies, worst: false) then RetailLessStable
        else FinancialInstitution                                          @cite("APG 210 §119")
      Sme =>
        let g = conservative(c.sme_group, worst: none, best: solo(c))
        if conservative(c.managed_as_retail, worst: false)
           && g != none
           && SmeGroups[g].total < sme_threshold
        then SmeRetail
        else NonFinancialCorporate                                         @cite("Att A §46; ARS item 9.1")
      NonFinancialCorporate    => NonFinancialCorporate
      FinancialInstitution     => FinancialInstitution
    }

  // ---------------------------------------------------------------- 30-day horizon & NSFR maturity

  fn horizon(d: Deposit) -> Horizon =
    match d.contract {
      UMP => Demand
      CLM(n, grace_end) =>
        if grace_end >= reporting_date then Demand                           @cite("APG 210 §122")
        else if let NoticeGiven(_, r) = latest_notice(d) then
          (if days(reporting_date, r) <= 30 then Called else Excluded)       @cite("APG 210 §121")
        else if n >= 31 then Excluded
        else Demand
      PAM(maturity, ew) =>
        let w = conservative(ew, worst: Permitted, best: NoLegalRight)
        if days(reporting_date, maturity) <= 30 then Demand
        else if w == Permitted || (w == NoLegalRight && d.product_class in Tainted) then Demand
                                                                             @cite("Att A §§41-42")
        else Excluded
    }

  // Att C §8: liabilities mature at the earliest date the funds may be redeemed.
  fn earliest_redemption(d: Deposit) -> Date =
    match d.contract {
      UMP => reporting_date
      CLM(n, grace_end) =>
        if grace_end >= reporting_date then reporting_date
        else if let NoticeGiven(_, r) = latest_notice(d) then r
        else reporting_date + n.days
      PAM(maturity, ew) =>
        let w = conservative(ew, worst: Permitted, best: NoLegalRight)
        if w == Permitted || (w == NoLegalRight && d.product_class in Tainted) || maturity < reporting_date
        then reporting_date
        else maturity
    }

  // ---------------------------------------------------------------- stability & scorecard

  fn score(d: Deposit, covered: Bool) -> Int =
      (if !covered then 2 else 0)
    + (if conservative(d.online, worst: true) then 2 else 0)
    + (if !conservative(d.holder.established_relationship, worst: false) then 1 else 0)
    + (if conservative(d.rate_driven, worst: true) then 1 else 0)          @cite("Att A Tables 1-2")

  fn stability(d: Deposit, covered: Bool) -> Stability =
    if covered && class(d.holder) != RetailLessStable
       && (conservative(d.holder.established_relationship, worst: false)
           || conservative(d.transactional, worst: false)) then Stable      @cite("Att A §37")
    else if score(d, covered) >= 3 then HigherRunOff
    else LessStable

  fn lcr_rate(d: Deposit, covered: Bool) -> Rate =
    match horizon(d) {
      Excluded => 0%
      Called   => 100%
      Demand   => match stability(d, covered) {
                    Stable       => 5%
                    LessStable   => 10%
                    HigherRunOff => 25%
                  }
    }                                                                        @cite("Att A Table 3")

  // ---------------------------------------------------------------- FCS cover (per depositor)
  // `maximize` outflow is the conservative default; `minimize` is the design's
  // optimal allocation and needs sign-off (APG 210 is silent on the split).

  alloc covered : ConservationSplit(Deposit.balance, per: holder) =
    optimize per holder where class(holder) in [Retail, RetailLessStable, SmeRetail] {
      maximize sum(d in holder.deposits |
                   lcr_rate(d, covered: true) * covered[d]
                 + lcr_rate(d, covered: false) * (d.balance - covered[d]))
      subject to
        sum(d in holder.deposits | covered[d])
          == min(fcs_limit, sum(d in holder.deposits
                                where conservative(d.fcs_eligible, worst: false) | d.balance))
        forall d in holder.deposits,
          0.AUD <= covered[d] <= (if conservative(d.fcs_eligible, worst: false) then d.balance else 0.AUD)
    }                                                                        @cite("APG 210 §§109, 114")
                                                                             @policy(minimize: requires_signoff)

  // ---------------------------------------------------------------- into the forms
  // Cases must be exhaustive and mutually exclusive: a compiler proof obligation.

  partition d: Deposit into Arf210_1A, Arf210_6 splitting d.balance by covered: covered[d] {
    case class(d.holder) in [Retail, RetailLessStable, SmeRetail] =>
      let p = if class(d.holder) == SmeRetail then "9.1" else "8"
      lcr: match (horizon(d), stability(d, covered)) {
        (Excluded, _)                   => none
        (Called, _)                     => item(p, 6)
        (Demand, Stable)                => item(p, 1)
        (Demand, LessStable) if covered => item(p, 3)
        (Demand, LessStable)            => item(p, 4)
        (Demand, HigherRunOff)          => item(p, 5)
      }
      nsfr: (if stability(d, covered) == Stable then "3" else "5", bucket(earliest_redemption(d)))

    case class(d.holder) == NonFinancialCorporate =>                         // non-operational
      let insured = all(x in d.holder.deposits | conservative(x.fcs_eligible, worst: false))
                    && sum(x in d.holder.deposits | x.balance) <= fcs_limit  @cite("ARS p.47")
      lcr: match horizon(d) {
        Excluded => none
        Called   => "9.2.7"
        Demand   => if insured then "9.2.5" else "9.2.6"
      }
      nsfr: ("9", bucket(earliest_redemption(d)))

    case class(d.holder) == FinancialInstitution =>
      lcr: if horizon(d) == Excluded then none else "9.5.5"
      nsfr: ("12", bucket(earliest_redemption(d)))
  }

  // ---------------------------------------------------------------- proof obligations

  invariant conservation:
    forall d: Deposit, sum(s in slices(d) | s.amount) == d.balance

  extern fn crossing_2m_threshold(c: Customer) -> Bool
  extern fn asf_before(c: Customer) -> Money<AUD, Carrying>
  extern fn asf_after(c: Customer) -> Money<AUD, Carrying>
  extern fn asf(book: Book, mode: Mode) -> Money<AUD, Carrying>
  extern fn lcr_outflow(book: Book, mode: Mode) -> Money<AUD, Carrying>
  extern fn single_deposit_per_holder(book: Book) -> Bool
  extern fn no_sme(book: Book) -> Bool

  // The design sketch's theorem, stated for the metric where it holds. For the
  // LCR it is false: an SME crossing AUD 2m with a high-scoring retail deposit
  // (25%) becomes fully insured wholesale (20%).
  theorem sme_cliff_never_increases_stable_funding:
    forall c: Customer, c.kind == Sme && crossing_2m_threshold(c) ==> asf_after(c) <= asf_before(c)

  // Missing data never helps - only where FCS cover isn't shared across accounts.
  theorem unknowns_are_prudent:
    forall book: Book, single_deposit_per_holder(book) && no_sme(book) ==>
      lcr_outflow(book, Conservative) >= lcr_outflow(book, Optimistic)
      && asf(book, Conservative) <= asf(book, Optimistic)
}
