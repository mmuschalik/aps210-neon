// Prudence form spec. Source of truth: edit this file, not code.
// Source: ARS 210.0 (F2023L00417) forms and instructions; APS 210 (July 2025).
// Format with: cargo run -p arf210 -- fmt <form>

@reporting("ARS 210.0", version: "2023-03-31")
form Arf210_1A("ARF 210.1A", "Liquidity Coverage Ratio - all currencies") {
  columns amount, weight, weighted, value
  input amount

  item "1" "HQLA1" {
    amount   = [1.1:amount] + [1.2:amount] + [1.3:amount] + [1.4:amount]
    weighted = [1.1:weighted] + [1.2:weighted] + [1.3:weighted] + [1.4:weighted]
  } @cite("sum of items 1.1, 1.2, 1.3, 1.4")

  item "1.1" "Notes and coin" {
    amount   = input
    weight   = 1
    weighted = [1.1:amount] * [1.1:weight]
  }

  item "1.2" "Central bank balances" {
    amount   = [1.2.1:amount] + [1.2.2:amount]
    weighted = [1.2.1:weighted] + [1.2.2:weighted]
  } @cite("sum of items 1.2.1, 1.2.2")

  item "1.2.1" "Held with the RBA" {
    amount   = input
    weight   = 1
    weighted = [1.2.1:amount] * [1.2.1:weight]
  }

  item "1.2.2" "Held with foreign central banks" {
    amount   = input
    weight   = 1
    weighted = [1.2.2:amount] * [1.2.2:weight]
  }

  item "1.3" "Securities with zero per cent risk weight" {
    amount   = [1.3.1:amount] + [1.3.2:amount] + [1.3.3:amount] + [1.3.4:amount] + [1.3.5:amount] + [1.3.6:amount] + [1.3.7:amount] + [1.3.8:amount]
    weighted = [1.3.1:weighted] + [1.3.2:weighted] + [1.3.3:weighted] + [1.3.4:weighted] + [1.3.5:weighted] + [1.3.6:weighted] + [1.3.7:weighted] + [1.3.8:weighted]
  } @cite("sum of items 1.3.1, 1.3.2, 1.3.3, 1.3.4, 1.3.5, 1.3.6, 1.3.7, 1.3.8")

  item "1.3.1" "Australian Government" {
    amount   = input
    weight   = 1
    weighted = [1.3.1:amount] * [1.3.1:weight]
  }

  item "1.3.2" "Australian State Government or Territory Central Borrowing Authorities" {
    amount   = input
    weight   = 1
    weighted = [1.3.2:amount] * [1.3.2:weight]
  }

  item "1.3.3" "Issued by foreign sovereigns" {
    amount   = input
    weight   = 1
    weighted = [1.3.3:amount] * [1.3.3:weight]
  }

  item "1.3.4" "Guaranteed by the Australian Government" {
    amount   = input
    weight   = 1
    weighted = [1.3.4:amount] * [1.3.4:weight]
  }

  item "1.3.5" "Guaranteed by foreign sovereigns" {
    amount   = input
    weight   = 1
    weighted = [1.3.5:amount] * [1.3.5:weight]
  }

  item "1.3.6" "Issued or guaranteed by central banks" {
    amount   = input
    weight   = 1
    weighted = [1.3.6:amount] * [1.3.6:weight]
  }

  item "1.3.7" "Issued or guaranteed by PSEs" {
    amount   = input
    weight   = 1
    weighted = [1.3.7:amount] * [1.3.7:weight]
  }

  item "1.3.8" "Issued or guaranteed by BIS, IMF, ECB and EC or MDBs" {
    amount   = input
    weight   = 1
    weighted = [1.3.8:amount] * [1.3.8:weight]
  }

  item "1.4" "Sovereign/central bank debt, non-zero risk-weight sovereign" {
    amount   = [1.4.1:amount] + [1.4.2:amount]
    weighted = [1.4.1:weighted] + [1.4.2:weighted]
  } @cite("sum of items 1.4.1, 1.4.2")

  item "1.4.1" "Issued in domestic currencies where liquidity risk is taken" {
    amount   = input
    weight   = 1
    weighted = [1.4.1:amount] * [1.4.1:weight]
  }

  item "1.4.2" "Issued in foreign currencies up to stressed NCO in that currency" {
    amount   = input
    weight   = 1
    weighted = [1.4.2:amount] * [1.4.2:weight]
  }

  item "1.5" "Adjusted amount of HQLA1 stock" {
    amount   = max([1:amount] + [1.5.1:amount] + [1.5.2:amount], 0)
    weight   = 1
    weighted = [1.5:amount] * [1.5:weight]
  } @cite("ARS p.41 formula; APS 210 Att A para 8")

  item "1.5.1" "Adjustment due to secured lending/borrowing transactions" {
    amount   = [11.1.2:amount] + [11.7.2:amount] + [19.1.1.1:amount] + [19.1.2.1:amount] + [19.1.3.1:amount] + [19.1.4.1:amount] - [19.1.1.2:amount] - [11.1.1:amount] - [11.2.1:amount] - [11.3.1:amount] - [11.4.1:amount] - [11.7.1:amount] - [11.7.3:amount] - [11.7.5:amount] - [11.7.7:amount]
    weight   = 1
    weighted = [1.5.1:amount] * [1.5.1:weight]
  } @cite("ARS p.41 formula")

  item "1.5.2" "Adjustment due to collateral swaps" {
    amount   = input
    weight   = 1
    weighted = [1.5.2:amount] * [1.5.2:weight]
  }

  item "2" "HQLA2A" {
    amount   = [2.1:amount] + [2.2:amount] + [2.3:amount] + [2.4:amount]
    weighted = [2.1:weighted] + [2.2:weighted] + [2.3:weighted] + [2.4:weighted]
  } @cite("sum of items 2.1, 2.2, 2.3, 2.4")

  item "2.1" "Sovereign/central bank securities, 20% risk weight" {
    amount   = input
    weight   = 0.85
    weighted = [2.1:amount] * [2.1:weight]
  }

  item "2.2" "PSE or MDB securities, 20% risk weight" {
    amount   = input
    weight   = 0.85
    weighted = [2.2:amount] * [2.2:weight]
  }

  item "2.3" "Non-financial corporate securities (Credit Rating Grade 1)" {
    amount   = input
    weight   = 0.85
    weighted = [2.3:amount] * [2.3:weight]
  }

  item "2.4" "Covered bonds, not self-issued (Credit Rating Grade 1)" {
    amount   = input
    weight   = 0.85
    weighted = [2.4:amount] * [2.4:weight]
  }

  item "2.5" "Adjusted amount of HQLA2A stock" {
    amount   = [2:amount] + [2.5.1:amount] + [2.5.2:amount]
    weight   = 0.85
    weighted = [2.5:amount] * [2.5:weight]
  } @cite("ARS p.41")

  item "2.5.1" "Adjustment due to secured lending/borrowing transactions" {
    amount   = [11.2.2:amount] + [11.7.4:amount] - [19.1.2.2:amount]
    weight   = 0.85
    weighted = [2.5.1:amount] * [2.5.1:weight]
  } @cite("ARS p.42 formula")

  item "2.5.2" "Adjustment due to collateral swaps" {
    amount   = input
    weight   = 0.85
    weighted = [2.5.2:amount] * [2.5.2:weight]
  }

  item "3" "HQLA2B" {
    amount   = [3.1:amount] + [3.2:amount] + [3.3:amount]
    weighted = [3.1:weighted] + [3.2:weighted] + [3.3:weighted]
  } @cite("sum of items 3.1, 3.2, 3.3")

  item "3.1" "RMBS (Credit Rating Grade 1)" {
    amount   = input
    weight   = 0.75
    weighted = [3.1:amount] * [3.1:weight]
  }

  item "3.2" "Non-financial corporate securities (Credit Rating Grade 3)" {
    amount   = input
    weight   = 0.5
    weighted = [3.2:amount] * [3.2:weight]
  }

  item "3.3" "Non-financial common equity shares" {
    amount   = input
    weight   = 0.5
    weighted = [3.3:amount] * [3.3:weight]
  }

  item "3.4" "Adjusted amount of RMBS HQLA2B stock" {
    amount   = [3.1:amount] + [3.4.1:amount] + [3.4.2:amount]
    weight   = 0.75
    weighted = [3.4:amount] * [3.4:weight]
  } @cite("ARS p.42")

  item "3.4.1" "Adjustment due to secured lending/borrowing transactions" {
    amount   = [11.3.2:amount] + [11.7.6:amount] - [19.1.3.2:amount]
    weight   = 0.75
    weighted = [3.4.1:amount] * [3.4.1:weight]
  } @cite("ARS p.42 formula")

  item "3.4.2" "Adjustment due to collateral swaps" {
    amount   = input
    weight   = 0.75
    weighted = [3.4.2:amount] * [3.4.2:weight]
  }

  item "3.5" "Adjusted amount of non-RMBS HQLA2B stock" {
    amount   = [3.2:amount] + [3.3:amount] + [3.5.1:amount] + [3.5.2:amount]
    weight   = 0.5
    weighted = [3.5:amount] * [3.5:weight]
  } @cite("ARS p.42")

  item "3.5.1" "Adjustment due to secured lending/borrowing transactions" {
    amount   = [11.4.2:amount] + [11.7.8:amount] - [19.1.4.2:amount]
    weight   = 0.5
    weighted = [3.5.1:amount] * [3.5.1:weight]
  } @cite("ARS p.42 formula")

  item "3.5.2" "Adjustment due to collateral swaps" {
    amount   = input
    weight   = 0.5
    weighted = [3.5.2:amount] * [3.5.2:weight]
  }

  item "3.6" "Adjusted amount of HQLA2B (RMBS and non-RMBS) stock" {
    amount   = [3.4:amount] + [3.5:amount]
    weighted = [3.4:weighted] + [3.5:weighted]
  } @cite("sum of items 3.4, 3.5")

  item "4" "Total HQLA" {
    weighted = [1:weighted] + [2:weighted] + [3:weighted] + [4.3:weighted] - [4.1:weighted] - [4.2:weighted]
  } @cite("ARS p.43")

  item "4.1" "Adjustment to stock of HQLA due to the 15 per cent cap on HQLA2B" {
    weighted = max([3.6:weighted] - 15 / 85 * ([1.5:weighted] + [2.5:weighted]), [3.6:weighted] - 15 / 60 * [1.5:weighted], 0)
  } @cite("ARS p.43 formula; APS 210 Att A para 7")

  item "4.2" "Adjustment to stock of HQLA due to the 40 per cent cap on HQLA2" {
    weighted = max([2.5:weighted] + [3.6:weighted] - [4.1:weighted] - 2 / 3 * [1.5:weighted], 0)
  } @cite("ARS p.43 formula; APS 210 Att A para 7")

  item "4.3" "Adjustment for other liquid assets approved by APRA" {
    weighted = input
  }

  item "5" "RBNZ eligible securities (after RBNZ haircuts)" {
    amount   = input
    weight   = 1
    weighted = [5:amount] * [5:weight]
  }

  item "6" "Alternative liquid assets (ALA)" {
    amount   = [6.3:amount] + [6.5:amount]
    weighted = [6.3:weighted] + [6.5:weighted]
  } @cite("sum of items 6.3, 6.5")

  item "6.1" "Market value of total eligible assets securing the CLF less RBA margin" {
    amount = [6.1.1:amount] + [6.1.2:amount] + [6.1.3:amount] + [6.1.4:amount] + [6.1.5:amount] + [6.1.6:amount]
  }

  item "6.1.1" "Securities issued by supranationals and foreign government" {
    amount = input
  }

  item "6.1.2" "Securities with Australian Government or foreign sovereign guarantee" {
    amount = input
  }

  item "6.1.3" "ADI issued securities" {
    amount = input
  }

  item "6.1.4" "Asset backed securities" {
    amount = input
  }

  item "6.1.5" "Other private securities" {
    amount = input
  }

  item "6.1.6" "Self-securitised assets" {
    amount = input
  }

  item "6.2" "Available amount of the CLF for the LCR calculation" {
    amount = if [6.2.2:amount] + [6.2.3:amount] > [6.2.1:amount] then 0 else [6.2.1:amount] - [6.2.2:amount] - [6.2.3:amount]
  } @cite("ARS p.44 formula; APS 210 Att A para 15(b)")

  item "6.2.1" "Approved size of the CLF" {
    amount = input
  }

  item "6.2.2" "Adjustment due to secured funding/lending transactions" {
    amount = max([11.5.1:amount] - [19.1.5.1:amount], 0)
  } @cite("ARS p.44 formula")

  item "6.2.3" "Adjustment due to collateral swaps" {
    amount = input
  }

  item "6.3" "Amount of eligible CLF assets included in the LCR numerator" {
    amount   = min([6.1:amount], [6.2:amount])
    weight   = 1
    weighted = [6.3:amount] * [6.3:weight]
  } @cite("ARS p.44 formula; APS 210 Att A para 15")

  item "6.4" "Of item 6.1: CLF securities maturing <= 30 days not returned under maturing secured lending" {
    amount = input
  } @cite("memo / of which")

  item "6.5" "Amount available as ALA in offshore jurisdictions (weighted)" {
    amount   = input
    weight   = 1
    weighted = [6.5:amount] * [6.5:weight]
  }

  item "7" "Total HQLA plus RBNZ eligible securities plus ALA" {
    weighted = [4:weighted] + [5:weighted] + [6:weighted]
  } @cite("ARS p.45")

  item "7.1" "AUD" {
    weighted = input
  }

  item "7.2" "NZD" {
    weighted = input
  }

  item "7.3" "USD" {
    weighted = input
  }

  item "7.4" "GBP" {
    weighted = input
  }

  item "7.5" "EUR" {
    weighted = input
  }

  item "7.6" "JPY" {
    weighted = input
  }

  item "7.7" "RMB" {
    weighted = input
  }

  item "7.8" "All other currencies" {
    weighted = [7:weighted] - ([7.1:weighted] + [7.2:weighted] + [7.3:weighted] + [7.4:weighted] + [7.5:weighted] + [7.6:weighted] + [7.7:weighted])
  } @cite("ARS p.45")

  item "8" "Retail deposits" {
    amount   = [8.1:amount] + [8.2:amount] + [8.3:amount] + [8.4:amount] + [8.5:amount] + [8.6:amount]
    weighted = [8.1:weighted] + [8.2:weighted] + [8.3:weighted] + [8.4:weighted] + [8.5:weighted] + [8.6:weighted]
  } @cite("sum of items 8.1, 8.2, 8.3, 8.4, 8.5, 8.6")

  item "8.1" "Stable deposits" {
    amount   = input
    weight   = 0.05
    weighted = [8.1:amount] * [8.1:weight]
  } @cite("APS 210 Att A Table 3")

  item "8.2" "Stable deposits eligible for 3 per cent run-off rate" {
    amount   = input
    weight   = 0.03
    weighted = [8.2:amount] * [8.2:weight]
  } @cite("APS 210 Att A Table 3")

  item "8.3" "Less stable deposits covered by FCS or government deposit insurance" {
    amount   = input
    weight   = 0.1
    weighted = [8.3:amount] * [8.3:weight]
  } @cite("APS 210 Att A Table 3")

  item "8.4" "Less stable deposits not covered by FCS or government deposit insurance" {
    amount   = input
    weight   = 0.1
    weighted = [8.4:amount] * [8.4:weight]
  } @cite("APS 210 Att A Table 3")

  item "8.5" "Less stable deposits with higher run-off rate" {
    amount   = input
    weight   = 0.25
    weighted = [8.5:amount] * [8.5:weight]
  } @cite("APS 210 Att A Table 3")

  item "8.6" "Called notice period deposits with 30 days or less to maturity" {
    amount   = input
    weight   = 1
    weighted = [8.6:amount] * [8.6:weight]
  } @cite("APS 210 Att A Table 3")

  item "9" "Unsecured wholesale funding" {
    amount   = [9.1:amount] + [9.2:amount] + [9.3:amount] + [9.4:amount] + [9.5:amount]
    weighted = [9.1:weighted] + [9.2:weighted] + [9.3:weighted] + [9.4:weighted] + [9.5:weighted]
  } @cite("sum of items 9.1, 9.2, 9.3, 9.4, 9.5")

  item "9.1" "SME" {
    amount   = [9.1.1:amount] + [9.1.2:amount] + [9.1.3:amount] + [9.1.4:amount] + [9.1.5:amount] + [9.1.6:amount]
    weighted = [9.1.1:weighted] + [9.1.2:weighted] + [9.1.3:weighted] + [9.1.4:weighted] + [9.1.5:weighted] + [9.1.6:weighted]
  } @cite("sum of items 9.1.1, 9.1.2, 9.1.3, 9.1.4, 9.1.5, 9.1.6")

  item "9.1.1" "Stable deposits" {
    amount   = input
    weight   = 0.05
    weighted = [9.1.1:amount] * [9.1.1:weight]
  } @cite("APS 210 Att A Table 3; SME < AUD 2m")

  item "9.1.2" "Stable deposits eligible for 3 per cent run-off rate" {
    amount   = input
    weight   = 0.03
    weighted = [9.1.2:amount] * [9.1.2:weight]
  } @cite("APS 210 Att A Table 3; SME < AUD 2m")

  item "9.1.3" "Less stable deposits covered by FCS or government deposit insurance" {
    amount   = input
    weight   = 0.1
    weighted = [9.1.3:amount] * [9.1.3:weight]
  } @cite("APS 210 Att A Table 3; SME < AUD 2m")

  item "9.1.4" "Less stable deposits not covered by FCS or government deposit insurance" {
    amount   = input
    weight   = 0.1
    weighted = [9.1.4:amount] * [9.1.4:weight]
  } @cite("APS 210 Att A Table 3; SME < AUD 2m")

  item "9.1.5" "Less stable deposits with higher run-off rate" {
    amount   = input
    weight   = 0.25
    weighted = [9.1.5:amount] * [9.1.5:weight]
  } @cite("APS 210 Att A Table 3; SME < AUD 2m")

  item "9.1.6" "Called notice period deposits with 30 days or less to maturity" {
    amount   = input
    weight   = 1
    weighted = [9.1.6:amount] * [9.1.6:weight]
  } @cite("APS 210 Att A Table 3; SME < AUD 2m")

  item "9.2" "Non-financial corporate" {
    amount   = [9.2.2:amount] + [9.2.3:amount] + [9.2.4:amount] + [9.2.5:amount] + [9.2.6:amount] + [9.2.7:amount]
    weighted = [9.2.2:weighted] + [9.2.3:weighted] + [9.2.4:weighted] + [9.2.5:weighted] + [9.2.6:weighted] + [9.2.7:weighted]
  } @cite("sum of items 9.2.2, 9.2.3, 9.2.4, 9.2.5, 9.2.6, 9.2.7")

  item "9.2.1" "of which: Intra-group" {
    amount = input
  } @cite("memo / of which")

  item "9.2.2" "Operational deposit amounts fully covered by deposit insurance" {
    amount   = input
    weight   = 0.05
    weighted = [9.2.2:amount] * [9.2.2:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.2.3" "Operational deposit amounts fully covered and eligible for 3 per cent run-off" {
    amount   = input
    weight   = 0.03
    weighted = [9.2.3:amount] * [9.2.3:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.2.4" "Operational deposit amounts not fully covered by deposit insurance" {
    amount   = input
    weight   = 0.25
    weighted = [9.2.4:amount] * [9.2.4:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.2.5" "Non-operational deposits where the entire deposit is fully covered" {
    amount   = input
    weight   = 0.2
    weighted = [9.2.5:amount] * [9.2.5:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.2.6" "Non-operational deposits where the entire deposit is not fully covered" {
    amount   = input
    weight   = 0.4
    weighted = [9.2.6:amount] * [9.2.6:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.2.7" "Called notice period deposits with 30 days or less to maturity" {
    amount   = input
    weight   = 1
    weighted = [9.2.7:amount] * [9.2.7:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.3" "Sovereign, central bank, PSE and MDB" {
    amount   = [9.3.1:amount] + [9.3.2:amount] + [9.3.3:amount] + [9.3.4:amount] + [9.3.5:amount] + [9.3.6:amount] + [9.3.7:amount]
    weighted = [9.3.1:weighted] + [9.3.2:weighted] + [9.3.3:weighted] + [9.3.4:weighted] + [9.3.5:weighted] + [9.3.6:weighted] + [9.3.7:weighted]
  } @cite("sum of items 9.3.1, 9.3.2, 9.3.3, 9.3.4, 9.3.5, 9.3.6, 9.3.7")

  item "9.3.1" "Operational deposit amounts fully covered by deposit insurance" {
    amount   = input
    weight   = 0.05
    weighted = [9.3.1:amount] * [9.3.1:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.3.2" "Operational deposit amounts fully covered and eligible for 3 per cent run-off" {
    amount   = input
    weight   = 0.03
    weighted = [9.3.2:amount] * [9.3.2:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.3.3" "Operational deposit amounts not fully covered by deposit insurance" {
    amount   = input
    weight   = 0.25
    weighted = [9.3.3:amount] * [9.3.3:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.3.4" "Non-operational deposits where the entire deposit is fully covered" {
    amount   = input
    weight   = 0.2
    weighted = [9.3.4:amount] * [9.3.4:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.3.5" "Non-operational deposits where the entire deposit is not fully covered" {
    amount   = input
    weight   = 0.4
    weighted = [9.3.5:amount] * [9.3.5:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.3.6" "Called notice period deposits with 30 days or less to maturity" {
    amount   = input
    weight   = 1
    weighted = [9.3.6:amount] * [9.3.6:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.3.7" "Additional balances required to be installed in central bank reserves" {
    amount   = input
    weight   = 1
    weighted = [9.3.7:amount] * [9.3.7:weight]
  }

  item "9.4" "ADI/Bank" {
    amount   = [9.4.2:amount] + [9.4.3:amount] + [9.4.4:amount] + [9.4.5:amount]
    weighted = [9.4.2:weighted] + [9.4.3:weighted] + [9.4.4:weighted] + [9.4.5:weighted]
  } @cite("sum of items 9.4.2, 9.4.3, 9.4.4, 9.4.5")

  item "9.4.1" "of which: Intra-group" {
    amount = input
  } @cite("memo / of which")

  item "9.4.2" "Operational deposit amounts fully covered by deposit insurance" {
    amount   = input
    weight   = 0.05
    weighted = [9.4.2:amount] * [9.4.2:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.4.3" "Operational deposit amounts fully covered and eligible for 3 per cent run-off" {
    amount   = input
    weight   = 0.03
    weighted = [9.4.3:amount] * [9.4.3:weight]
  } @cite("APS 210 Att A Table 3")

  item "9.4.4" "Operational deposit amounts not fully covered by deposit insurance" {
