  item "19.2.4" "Secured by non-RMBS HQLA2B" {
    amount   = input
    weight   = 0
    weighted = [19.2.4:amount] * [19.2.4:weight]
  } @cite("APS 210 Att A Table 4 (collateral covers short positions)")

  item "19.2.5" "Margin lending backed by non-HQLA1 or non-HQLA2" {
    amount   = input
    weight   = 0
    weighted = [19.2.5:amount] * [19.2.5:weight]
  } @cite("APS 210 Att A Table 4 (collateral covers short positions)")

  item "19.2.6" "Secured by other collateral" {
    amount   = input
    weight   = 0
    weighted = [19.2.6:amount] * [19.2.6:weight]
  } @cite("APS 210 Att A Table 4 (collateral covers short positions)")

  item "20" "Other inflows by counterparty" {
    amount   = [20.1:amount] + [20.2:amount] + [20.3:amount] + [20.4:amount] + [20.5:amount] + [20.6:amount]
    weighted = [20.1:weighted] + [20.2:weighted] + [20.3:weighted] + [20.4:weighted] + [20.5:weighted] + [20.6:weighted]
  } @cite("sum of items 20.1, 20.2, 20.3, 20.4, 20.5, 20.6")

  item "20.1" "Retail customer" {
    amount   = input
    weight   = 0.5
    weighted = [20.1:amount] * [20.1:weight]
  } @cite("APS 210 Att A paras 62-63")

  item "20.2" "SME" {
    amount   = input
    weight   = 0.5
    weighted = [20.2:amount] * [20.2:weight]
  } @cite("APS 210 Att A paras 62-63")

  item "20.3" "Non-financial corporate" {
    amount   = input
    weight   = 0.5
    weighted = [20.3:amount] * [20.3:weight]
  } @cite("APS 210 Att A paras 62-63")

  item "20.4" "Central bank" {
    amount   = input
    weight   = 1
    weighted = [20.4:amount] * [20.4:weight]
  } @cite("APS 210 Att A paras 62-63")

  item "20.5" "Financial institution" {
    amount   = input
    weight   = 1
    weighted = [20.5:amount] * [20.5:weight]
  } @cite("APS 210 Att A paras 62-63")

  item "20.6" "Other entities" {
    amount   = input
    weight   = 0.5
    weighted = [20.6:amount] * [20.6:weight]
  } @cite("APS 210 Att A paras 62-63")

  item "20.7" "of which: Intra-group (ADI/bank)" {
    amount = input
  } @cite("memo / of which")

  item "20.8" "of which: Intra-group (financial institutions)" {
    amount = input
  } @cite("memo / of which")

  item "20.9" "of which: Intra-group (other entities)" {
    amount = input
  } @cite("memo / of which")

  item "21" "Other cash inflows" {
    amount   = [21.1:amount] + [21.2:amount] + [21.3:amount] + [21.4:amount] + [21.5:amount]
    weighted = [21.1:weighted] + [21.2:weighted] + [21.3:weighted] + [21.4:weighted] + [21.5:weighted]
  } @cite("sum of items 21.1, 21.2, 21.3, 21.4, 21.5")

  item "21.1" "Derivatives cash inflows" {
    amount   = input
    weight   = 1
    weighted = [21.1:amount] * [21.1:weight]
  }

  item "21.2" "Contractual inflows from CLF securities maturing <= 30 days in excess of available CLF" {
    amount   = if [6.1:amount] == [6.3:amount] then 0 else if [6.1:amount] - [6.3:amount] >= [6.4:amount] then [6.4:amount] else [6.1:amount] - [6.3:amount]
    weight   = 1
    weighted = [21.2:amount] * [21.2:weight]
  } @cite("ARS p.60 formula")

  item "21.3" "Contractual inflows from other securities maturing <= 30 days" {
    amount   = input
    weight   = 1
    weighted = [21.3:amount] * [21.3:weight]
  }

  item "21.4" "Other contractual cash inflows" {
    amount   = input
    weight   = 1
    weighted = [21.4:amount] * [21.4:weight]
  }

  item "21.5" "Amount of committed head office support (foreign ADIs, APRA approval)" {
    amount   = input
    weighted = min([21.5:amount], 0.2 * [18:weighted])
  } @cite("ARS p.61: min(facility, 20% of total outflows); APS 210 Att A para 61")

  item "22" "Cash inflows due to collateral swaps (weighted)" {
    weighted = input
  }

  item "23" "Total cash inflows" {
    amount   = [19:amount] + [20:amount] + [21:amount]
    weighted = [19:weighted] + [20:weighted] + [21:weighted] + [22:weighted]
  } @cite("ARS p.61")

  item "23.1" "AUD" {
    amount   = input
    weighted = input
  } @cite("memo / of which")

  item "23.2" "NZD" {
    amount   = input
    weighted = input
  } @cite("memo / of which")

  item "23.3" "USD" {
    amount   = input
    weighted = input
  } @cite("memo / of which")

  item "23.4" "GBP" {
    amount   = input
    weighted = input
  } @cite("memo / of which")

  item "23.5" "EUR" {
    amount   = input
    weighted = input
  } @cite("memo / of which")

  item "23.6" "JPY" {
    amount   = input
    weighted = input
  } @cite("memo / of which")

  item "23.7" "RMB" {
    amount   = input
    weighted = input
  } @cite("memo / of which")

  item "23.8" "All other currencies" {
    amount   = input
    weighted = input
  } @cite("memo / of which")

  item "24" "Cash outflows minus cash inflows" {
    amount   = [18:amount] - [23:amount]
    weighted = [18:weighted] - [23:weighted]
  } @cite("ARS p.62")

  item "24.1" "AUD" {
    amount   = [18.1:amount] - [23.1:amount]
    weighted = [18.1:weighted] - [23.1:weighted]
  }

  item "24.2" "NZD" {
    amount   = [18.2:amount] - [23.2:amount]
    weighted = [18.2:weighted] - [23.2:weighted]
  }

  item "24.3" "USD" {
    amount   = [18.3:amount] - [23.3:amount]
    weighted = [18.3:weighted] - [23.3:weighted]
  }

  item "24.4" "GBP" {
    amount   = [18.4:amount] - [23.4:amount]
    weighted = [18.4:weighted] - [23.4:weighted]
  }

  item "24.5" "EUR" {
    amount   = [18.5:amount] - [23.5:amount]
    weighted = [18.5:weighted] - [23.5:weighted]
  }

  item "24.6" "JPY" {
    amount   = [18.6:amount] - [23.6:amount]
    weighted = [18.6:weighted] - [23.6:weighted]
  }

  item "24.7" "RMB" {
    amount   = [18.7:amount] - [23.7:amount]
    weighted = [18.7:weighted] - [23.7:weighted]
  }

  item "24.8" "All other currencies" {
    amount   = [18.8:amount] - [23.8:amount]
    weighted = [18.8:weighted] - [23.8:weighted]
  }

  item "25" "Total HQLA" {
    value = [4:weighted]
  }

  item "26" "RBNZ eligible securities plus ALA" {
    value = [5:weighted] + [6:weighted]
  }

  item "27" "Total cash outflows" {
    value = [18:weighted]
  }

  item "28" "Total cash inflows after applying the inflow cap" {
    value = min([23:weighted], 0.75 * [27:value])
  } @cite("APS 210 Att A para 30")

  item "29" "Net cash outflows" {
    value = [27:value] + [29.1:value] - [28:value]
  }

  item "29.1" "Net cash outflows overlay (APRA-advised; zero if none)" {
    value = input
  }

  item "30" "LCR (%)" {
    value = ([25:value] + [26:value]) / [29:value] * 100
  }

  item "31" "Minimum LCR per liquidity management strategy" {
    value = input
  }

  item "32" "Lowest LCR during reporting period" {
    value = input
  }

  item "33" "Highest LCR during reporting period" {
    value = input
  }

  item "34" "Mean LCR during reporting period (business days)" {
    value = input
  }

  item "35" "LCR for significant currencies (free-form table, not modelled)" {}

  check "7.8>=0" "Currency split of item 7 exceeds the total": [7.8:weighted] >= 0
  check "18 ccy amount" "Currency split of item 18 (amount) must equal the total": [18.1:amount] + [18.2:amount] + [18.3:amount] + [18.4:amount] + [18.5:amount] + [18.6:amount] + [18.7:amount] + [18.8:amount] == [18:amount]
  check "18 ccy weighted" "Currency split of item 18 (weighted) must equal the total": [18.1:weighted] + [18.2:weighted] + [18.3:weighted] + [18.4:weighted] + [18.5:weighted] + [18.6:weighted] + [18.7:weighted] + [18.8:weighted] == [18:weighted]
  check "23 ccy amount" "Currency split of item 23 (amount) must equal the total": [23.1:amount] + [23.2:amount] + [23.3:amount] + [23.4:amount] + [23.5:amount] + [23.6:amount] + [23.7:amount] + [23.8:amount] == [23:amount]
  check "23 ccy weighted" "Currency split of item 23 (weighted) must equal the total": [23.1:weighted] + [23.2:weighted] + [23.3:weighted] + [23.4:weighted] + [23.5:weighted] + [23.6:weighted] + [23.7:weighted] + [23.8:weighted] == [23:weighted]
  check "6.2.3>=0" "Collateral-swap CLF adjustment must be entered as zero if negative": [6.2.3:amount] >= 0 @cite("ARS p.44")
  check "6.4<=6.1" "CLF securities maturing <= 30 days cannot exceed item 6.1": [6.4:amount] <= [6.1:amount]
  check "9.2.1<=9.2" "Intra-group 'of which' exceeds item 9.2": [9.2.1:amount] <= [9.2:amount]
  check "9.4.1<=9.4" "Intra-group 'of which' exceeds item 9.4": [9.4.1:amount] <= [9.4:amount]
  check "9.5.1<=9.5" "Intra-group 'of which' exceeds item 9.5": [9.5.1:amount] <= [9.5:amount]
  check "11.1.1<=11.1" "'of which' exceeds item 11.1": [11.1.1:amount] <= [11.1:amount]
  check "19.1.1.1<=19.1.1" "'of which' exceeds item 19.1.1": [19.1.1.1:amount] <= [19.1.1:amount]
  check "11.2.1<=11.2" "'of which' exceeds item 11.2": [11.2.1:amount] <= [11.2:amount]
  check "19.1.2.1<=19.1.2" "'of which' exceeds item 19.1.2": [19.1.2.1:amount] <= [19.1.2:amount]
  check "11.3.1<=11.3" "'of which' exceeds item 11.3": [11.3.1:amount] <= [11.3:amount]
  check "19.1.3.1<=19.1.3" "'of which' exceeds item 19.1.3": [19.1.3.1:amount] <= [19.1.3:amount]
  check "11.4.1<=11.4" "'of which' exceeds item 11.4": [11.4.1:amount] <= [11.4:amount]
  check "19.1.4.1<=19.1.4" "'of which' exceeds item 19.1.4": [19.1.4.1:amount] <= [19.1.4:amount]
  check "11.7 of-which" "'of which' rows exceed item 11.7": [11.7.1:amount] + [11.7.3:amount] + [11.7.5:amount] + [11.7.7:amount] <= [11.7:amount]
  check "20.7-20.9<=20" "Intra-group inflows exceed item 20": [20.7:amount] + [20.8:amount] + [20.9:amount] <= [20:amount]

  theorem "hqla2b-at-most-15pct" "After the caps, HQLA2B is at most 15% of the adjusted stock, for every possible return":
    [3.6:weighted] - [4.1:weighted] <= 0.15 * ([1.5:weighted] + [2.5:weighted] + [3.6:weighted] - [4.1:weighted] - [4.2:weighted]) @cite("APS 210 Att A paras 6-7")
  theorem "hqla2-at-most-40pct" "After the caps, HQLA2 is at most 40% of the adjusted stock, for every possible return":
    [2.5:weighted] + [3.6:weighted] - [4.1:weighted] - [4.2:weighted] <= 0.4 * ([1.5:weighted] + [2.5:weighted] + [3.6:weighted] - [4.1:weighted] - [4.2:weighted]) @cite("APS 210 Att A paras 6-7")
  theorem "cap-adjustments-non-negative" "The caps only ever remove liquid assets":
    [4.1:weighted] >= 0 && [4.2:weighted] >= 0
  theorem "inflow-cap" "Inflows count for at most 75% of outflows":
    [28:value] <= 0.75 * [27:value] @cite("APS 210 Att A para 30")
}
