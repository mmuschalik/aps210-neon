// Prudence form spec. Source of truth: edit this file, not code.
// Source: ARS 210.0 (F2023L00417) forms and instructions; APS 210 (July 2025).
// Format with: cargo run -p arf210 -- fmt <form>

@reporting("ARS 210.0", version: "2023-03-31")
form Arf210_2("ARF 210.2", "Minimum Liquidity Holdings Ratio") {
  columns amount
  input amount

  item "1" "Cash" {
    amount = [1.1:amount] + [1.2:amount] + [1.3:amount]
  } @cite("sum of 1.1, 1.2, 1.3")

  item "1.1" "Notes and coin" {
    amount = input
  }

  item "1.2" "Settlement funds due from clearing houses" {
    amount = input
  }

  item "1.3" "Settlement funds due from" {
    amount = [1.3.1:amount] + [1.3.2:amount] + [1.3.3:amount] + [1.3.4:amount] + [1.3.5:amount]
  } @cite("sum of 1.3.1, 1.3.2, 1.3.3, 1.3.4, 1.3.5")

  item "1.3.1" "RBA" {
    amount = input
  }

  item "1.3.2" "Major banks" {
    amount = input
  }

  item "1.3.3" "Other locally incorporated LCR ADIs" {
    amount = input
  }

  item "1.3.4" "Other locally incorporated ADIs not included above" {
    amount = input
  }

  item "1.3.5" "Foreign ADIs" {
    amount = input
  }

  item "2" "Australian Government and semi-government securities" {
    amount = [2.1:amount] + [2.2:amount]
  } @cite("sum of 2.1, 2.2")

  item "2.1" "Australian Government securities" {
    amount = input
  }

  item "2.2" "State Government or Territory Central Borrowing Authorities securities" {
    amount = input
  }

  item "3" "Debt securities with an Australian Government guarantee" {
    amount = input
  }

  item "4" "Supranationals and foreign governments" {
    amount = [4.1:amount] + [4.2:amount] + [4.3:amount]
  } @cite("sum of 4.1, 4.2, 4.3")

  item "4.1" "Debt securities issued by supranationals" {
    amount = input
  }

  item "4.2" "Debt securities issued by foreign sovereign governments" {
    amount = input
  }

  item "4.3" "Debt securities guaranteed by foreign sovereign governments" {
    amount = input
  }

  item "5" "Bank bills, certificates of deposit and debt securities issued by ADIs" {
    amount = [5.1:amount] + [5.2:amount] + [5.3:amount]
  } @cite("sum of 5.1, 5.2, 5.3")

  item "5.1" "Bank bills, commercial paper, other non-deposit obligations" {
    amount = input
  }

  item "5.2" "Negotiable certificates of deposit" {
    amount = input
  }

  item "5.3" "Debt securities" {
    amount = input
  }

  item "6" "Deposits held with other ADIs" {
    amount = [6.1:amount] + [6.2:amount]
  } @cite("sum of 6.1, 6.2")

  item "6.1" "Deposits on a call basis" {
    amount = [6.1.1:amount] + [6.1.2:amount] + [6.1.3:amount] + [6.1.4:amount] + [6.1.5:amount]
  } @cite("sum of 6.1.1, 6.1.2, 6.1.3, 6.1.4, 6.1.5")

  item "6.2" "Eligible deposits not on a call basis" {
    amount = [6.2.1:amount] + [6.2.2:amount] + [6.2.3:amount] + [6.2.4:amount] + [6.2.5:amount]
  } @cite("sum of 6.2.1, 6.2.2, 6.2.3, 6.2.4, 6.2.5")

  item "6.1.1" "Major banks" {
    amount = input
  }

  item "6.1.2" "Other locally incorporated LCR ADIs" {
    amount = input
  }

  item "6.1.3" "Other locally incorporated ADIs not included above" {
    amount = input
  }

  item "6.1.4" "Foreign ADIs" {
    amount = input
  }

  item "6.1.5" "Other deposits approved by APRA" {
    amount = input
  }

  item "6.2.1" "Major banks" {
    amount = input
  }

  item "6.2.2" "Other locally incorporated LCR ADIs" {
    amount = input
  }

  item "6.2.3" "Other locally incorporated ADIs not included above" {
    amount = input
  }

  item "6.2.4" "Foreign ADIs" {
    amount = input
  }

  item "6.2.5" "Other deposits approved by APRA" {
    amount = input
  }

  item "7" "Other securities approved by APRA" {
    amount = input
  }

  item "8" "Total MLH" {
    amount = [1:amount] + [2:amount] + [3:amount] + [4:amount] + [5:amount] + [6:amount] + [7:amount]
  } @cite("sum of 1, 2, 3, 4, 5, 6, 7")

  item "8.1" "of which: deposits placed with ADIs with a credit rating grade 3 or lower" {
    amount = input
  }

  item "8.2" "of which: debt securities issued by ADIs with a credit rating grade 3 or lower" {
    amount = input
  }

  item "9" "Placements by other ADIs" {
    amount = [9.1:amount] + [9.2:amount]
  } @cite("sum of 9.1, 9.2")

  item "9.1" "Deposits on a call basis placed with the reporting ADI by other ADIs" {
    amount = [9.1.1:amount] + [9.1.2:amount] + [9.1.3:amount] + [9.1.4:amount]
  } @cite("sum of 9.1.1, 9.1.2, 9.1.3, 9.1.4")

  item "9.2" "Deposits not on a call basis placed with the reporting ADI by other ADIs" {
    amount = [9.2.1:amount] + [9.2.2:amount] + [9.2.3:amount] + [9.2.4:amount]
  } @cite("sum of 9.2.1, 9.2.2, 9.2.3, 9.2.4")

  item "9.1.1" "Major banks" {
    amount = input
  }

  item "9.1.2" "Other locally incorporated LCR ADIs" {
    amount = input
  }

  item "9.1.3" "Other locally incorporated ADIs not included above" {
    amount = input
  }

  item "9.1.4" "Foreign ADIs" {
    amount = input
  }

  item "9.2.1" "Major banks" {
    amount = input
  }

  item "9.2.2" "Other locally incorporated LCR ADIs" {
    amount = input
  }

  item "9.2.3" "Other locally incorporated ADIs not included above" {
    amount = input
  }

  item "9.2.4" "Foreign ADIs" {
    amount = input
  }

  item "10" "Placements by other ADIs in excess of MLH deposits of the reporting ADI" {
    amount = max([9:amount] - [6:amount], 0)
  } @cite("ARS p.71 formula; netting across ADIs, not bilateral")

  item "11" "Total adjusted MLH" {
    amount = [8:amount] - [9:amount] + [10:amount]
  } @cite("ARS p.71 formula")

  item "12" "Liability base" {
    amount = [12.1:amount] - [12.2:amount] - [12.3:amount]
  } @cite("ARS p.72 formula")

  item "12.1" "Total liabilities" {
    amount = input
  }

  item "12.2" "Liabilities of securitisation SPVs meeting APS 120 capital relief requirements" {
    amount = input
  }

  item "12.3" "Placements by other ADIs up to the amount of MLH deposits of the reporting ADI" {
    amount = [9:amount] - [10:amount]
  } @cite("ARS p.72 formula")

  item "13" "Off-balance sheet irrevocable commitments" {
    amount = [13.1:amount] + [13.2:amount] + [13.3:amount] + [13.4:amount] + [13.5:amount] + [13.6:amount] + [13.7:amount] + [13.8:amount]
  } @cite("sum of 13.1, 13.2, 13.3, 13.4, 13.5, 13.6, 13.7, 13.8")

  item "13.1" "Trade finance related obligations" {
    amount = input
  }

  item "13.2" "Guarantees" {
    amount = input
  }

  item "13.3" "Standby letters of credit" {
    amount = input
  }

  item "13.4" "Undrawn formal standby facilities" {
    amount = input
  }

  item "13.5" "Loans approved but not advanced/funded" {
    amount = input
  }

  item "13.6" "Balance available for redraw of term loans" {
    amount = input
  }

  item "13.7" "Balance available under overdraft agreements" {
    amount = input
  }

  item "13.8" "All other irrevocable commitments" {
    amount = input
  }

  item "14" "Adjusted liability base" {
    amount = [12:amount] + [13:amount]
  } @cite("sum of 12, 13")

  item "15" "MLH ratio (%)" {
    amount = [11:amount] / [14:amount] * 100
  } @cite("ARS p.73")

  item "16" "Minimum MLH ratio per liquidity management strategy" {
    amount = input
  }

  item "17" "Lowest MLH ratio during reporting period" {
    amount = input
  }

  item "18" "Average MLH ratio during reporting period" {
    amount = input
  }

  item "19" "Highest MLH ratio during reporting period" {
    amount = input
  }

  check "8.1<=6" "Low-rated ADI deposits exceed item 6": [8.1:amount] <= [6:amount]
  check "8.2<=5+7" "Low-rated ADI securities exceed items 5 and 7": [8.2:amount] <= [5:amount] + [7:amount]

  theorem "netting-never-adds" "Netting placements by other ADIs never increases holdings or the liability base":
    [6:amount] >= 0 && [9:amount] >= 0
    ==> [11:amount] <= [8:amount] && 0 <= [12.3:amount] && [12.3:amount] <= [9:amount] @cite("ARS 210.0 p.71")
}
