// Prudence form spec. Source of truth: edit this file, not code.
// Source: ARS 210.0 (F2023L00417) forms and instructions; APS 210 (July 2025).
// Format with: cargo run -p arf210 -- fmt <form>

@reporting("ARS 210.0", version: "2023-03-31")
form Arf210_6("ARF 210.6", "Net Stable Funding Ratio") {
  columns b0, b1, b2, f0, f1, f2, amount, factor, calc, value
  input b0

  item "1" "Regulatory capital before adjustments, excl. Tier 2 with residual maturity < 1y" {
    b2   = input
    f2   = 1
    calc = [1:b2] * [1:f2]
  } @cite("APS 210 Att C para 11(a)")

  item "2" "Capital instruments not included above with residual maturity >= 1y" {
    b2   = input
    f2   = 1
    calc = [2:b2] * [2:f2]
  } @cite("APS 210 Att C para 11(b)")

  item "3" "Stable demand and term deposits from retail and SME customers" {
    b0   = input
    f0   = 0.95
    b1   = input
    f1   = 0.95
    b2   = input
    f2   = 1
    calc = [3:b0] * [3:f0] + [3:b1] * [3:f1] + [3:b2] * [3:f2]
  } @cite("APS 210 Att C para 12(a)")

  item "4" "Intermediated deposits, stable, ADI irreplaceable without 12 months' notice" {
    b0   = input
    f0   = 0.95
    b1   = input
    f1   = 0.95
    b2   = input
    f2   = 1
    calc = [4:b0] * [4:f0] + [4:b1] * [4:f1] + [4:b2] * [4:f2]
  } @cite("APS 210 Att C para 12(b)")

  item "5" "Less stable demand and term deposits from retail and SME customers" {
    b0   = input
    f0   = 0.9
    b1   = input
    f1   = 0.9
    b2   = input
    f2   = 1
    calc = [5:b0] * [5:f0] + [5:b1] * [5:f1] + [5:b2] * [5:f2]
  } @cite("APS 210 Att C para 13(a)")

  item "6" "Intermediated deposits, less stable, ADI irreplaceable without 12 months' notice" {
    b0   = input
    f0   = 0.9
    b1   = input
    f1   = 0.9
    b2   = input
    f2   = 1
    calc = [6:b0] * [6:f0] + [6:b1] * [6:f1] + [6:b2] * [6:f2]
  } @cite("APS 210 Att C para 13(b)")

  item "7" "Intermediated deposits, ADI irreplaceable without 6 months' notice" {
    b0   = input
    f0   = 0.5
    b1   = input
    f1   = 0.5
    b2   = input
    f2   = 1
    calc = [7:b0] * [7:f0] + [7:b1] * [7:f1] + [7:b2] * [7:f2]
  } @cite("APS 210 Att C para 14(d)")

  item "8" "Operational deposits" {
    b0   = [8.1:amount] + [8.2:amount]
    f0   = 0.5
    calc = [8:b0] * [8:f0]
  } @cite("APS 210 Att C para 14(b)-(c)")

  item "8.1" "Superannuation fund deposits" {
    amount = input
  }

  item "8.2" "All other customers" {
    amount = input
  }

  item "9" "Funding from non-financial corporates" {
    b0   = input
    f0   = 0.5
    b1   = input
    f1   = 0.5
    b2   = input
    f2   = 1
    calc = [9:b0] * [9:f0] + [9:b1] * [9:f1] + [9:b2] * [9:f2]
  } @cite("APS 210 Att C para 14(a)")

  item "10" "Funding from sovereigns/PSEs/MDBs/NDBs" {
