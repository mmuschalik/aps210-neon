  }

  item "55" "Total RSF from off-balance sheet exposures" {
    calc = [48:calc] + [49:calc] + [50:calc] + [51:calc] + [52:calc] + [53:calc] + [54:calc]
  }

  item "56" "Net stable funding ratio" {
    value = [19:calc] / ([47:calc] + [55:calc])
  } @cite("ARS p.157 formula (a ratio, not %)")

  check "52>=0" "Item 52: report zero for a net inflow": [52:amount] >= 0 @cite("ARS p.157")
  check "53>=0" "Item 53: report zero for a net inflow": [53:amount] >= 0 @cite("ARS p.157")

  theorem "derivatives-one-side" "NSFR derivatives are a net liability or a net asset, never both":
    [13:amount] == 0 || [40:amount] == 0 @cite("APS 210 Att C paras 15(c), 37(b)")
}
