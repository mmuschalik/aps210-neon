  item "40" "NSFR derivative assets net of NSFR derivative liabilities" {
    amount = max([40.1:amount] - [13.1:amount], 0)
    factor = 1
    calc   = [40:amount] * [40:factor]
  } @cite("ARS p.155 formula; APS 210 Att C para 37(b)")

  item "40.1" "NSFR derivative assets" {
    amount = [40.1.1:amount] - [40.1.2:amount]
  } @cite("ARS p.155 formula")

  item "40.1.1" "Derivative assets gross of variation margin received" {
    amount = input
  }

  item "40.1.2" "Cash variation margin received that can be included in NSFR derivative assets" {
    amount = input
  }

  item "41" "Derivative liabilities (20% of gross negative replacement cost)" {
    amount = 0.2 * [13.1.1:amount]
