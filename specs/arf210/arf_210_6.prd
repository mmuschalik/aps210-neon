  } @cite("APS 210 Att C paras 14(f), 15(a)")

  item "13" "NSFR derivative liabilities net of NSFR derivative assets" {
    amount = max([13.1:amount] - [40.1:amount], 0)
    factor = 0
    calc   = [13:amount] * [13:factor]
  } @cite("ARS p.148 formula; APS 210 Att C para 15(c)")

  item "13.1" "NSFR derivative liabilities" {
    amount = [13.1.1:amount] - [13.1.2:amount]
