  item "47" "Total RSF from on-balance sheet assets" {
    calc = [20:calc] + [21:calc] + [22:calc] + [23.1:calc] + [23.2.1:calc] + [23.2.2:calc] + [23.2.3:calc] + [24.1:calc] + [24.2.1:calc] + [24.2.2:calc] + [24.2.3:calc] + [25.1:calc] + [25.2.1:calc] + [25.2.2:calc] + [25.2.3:calc] + [26.1:calc] + [26.2.1:calc] + [26.2.2:calc] + [26.2.3:calc] + [27.1:calc] + [27.2.1:calc] + [27.2.2:calc] + [27.2.3:calc] + [28.1:calc] + [28.2.1:calc] + [28.2.2:calc] + [28.2.3:calc] + [29.1:calc] + [29.2.1:calc] + [29.2.2:calc] + [29.2.3:calc] + [30.1:calc] + [30.2.1:calc] + [30.2.2:calc] + [30.2.3:calc] + [31.1:calc] + [31.2.1:calc] + [31.2.2:calc] + [32.1:calc] + [32.2.1:calc] + [32.2.2:calc] + [32.2.3:calc] + [33.1:calc] + [33.2.1:calc] + [33.2.2:calc] + [34.1:calc] + [34.2.1:calc] + [34.2.2:calc] + [35.1:calc] + [35.2.1:calc] + [35.2.2:calc] + [36.1:calc] + [36.2.1:calc] + [36.2.2:calc] + [37.1:calc] + [37.2.1:calc] + [37.2.2:calc] + [38.1:calc] + [38.2.1:calc] + [38.2.2:calc] + [39:calc] + [40:calc] + [41:calc] + [42:calc] + [43:calc] + [44:calc] + [45:calc] + [46:calc]
  }

