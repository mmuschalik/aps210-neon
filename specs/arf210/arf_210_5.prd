    d15     = input
    d30     = input
    m2      = input
    m3      = input
    m4      = input
    m5      = input
    m6      = input
    total   = [6.3.1:at_call] + [6.3.1:d7] + [6.3.1:d15] + [6.3.1:d30] + [6.3.1:m2] + [6.3.1:m3] + [6.3.1:m4] + [6.3.1:m5] + [6.3.1:m6]
  }

  item "6.4" "Unsecured short-term wholesale funding" {
