    m3      = [6.1.1:m3] + [6.2.1:m3] + [6.3.1:m3] + [6.4.1:m3] + [6.5.1:m3] + [6.6.1:m3]
    m4      = [6.1.1:m4] + [6.2.1:m4] + [6.3.1:m4] + [6.4.1:m4] + [6.5.1:m4] + [6.6.1:m4]
    m5      = [6.1.1:m5] + [6.2.1:m5] + [6.3.1:m5] + [6.4.1:m5] + [6.5.1:m5] + [6.6.1:m5]
    m6      = [6.1.1:m6] + [6.2.1:m6] + [6.3.1:m6] + [6.4.1:m6] + [6.5.1:m6] + [6.6.1:m6]
    total   = [6.7.1:at_call] + [6.7.1:d7] + [6.7.1:d15] + [6.7.1:d30] + [6.7.1:m2] + [6.7.1:m3] + [6.7.1:m4] + [6.7.1:m5] + [6.7.1:m6]
  } @cite("ARS p.131 (\"sum of item 6.1.1 - 6.7.1\"): items 6.1.1 to 6.6.1")

