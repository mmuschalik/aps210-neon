  } @cite("ARS p.131 (\"sum of item 6.1 - 6.7\"): items 6.1 to 6.6")

  item "6.7.1" "of which: offshore" {
    at_call = [6.1.1:at_call] + [6.2.1:at_call] + [6.3.1:at_call] + [6.4.1:at_call] + [6.5.1:at_call] + [6.6.1:at_call]
    d7      = [6.1.1:d7] + [6.2.1:d7] + [6.3.1:d7] + [6.4.1:d7] + [6.5.1:d7] + [6.6.1:d7]
    d15     = [6.1.1:d15] + [6.2.1:d15] + [6.3.1:d15] + [6.4.1:d15] + [6.5.1:d15] + [6.6.1:d15]
    d30     = [6.1.1:d30] + [6.2.1:d30] + [6.3.1:d30] + [6.4.1:d30] + [6.5.1:d30] + [6.6.1:d30]
