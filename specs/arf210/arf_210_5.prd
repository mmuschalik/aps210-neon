    undrawn     = input
  }

  item "3.5" "Net outflows under any other committed facilities" {
    outflow     = input
    outflow_pct = input
    undrawn     = input
  }

  item "3.6" "Total net outflows under all contingent and committed funding agreements" {
    outflow     = [3.2:outflow] + [3.3:outflow] + [3.4:outflow] + [3.5:outflow]
    outflow_pct = input
    undrawn     = [3.2:undrawn] + [3.3:undrawn] + [3.4:undrawn] + [3.5:undrawn]
  } @cite("ARS p.130: sum of items 3.2 to 3.5 (the percentage is a weighted average, reported)")

  item "4" "Net collateral/margin outflow over last five business days" {}

  item "4.1" "Collateral or margin paid - initial" {
    outflow = input
  }

  item "4.2" "Collateral or margin received - initial" {
    outflow = input
  }

  item "4.3" "Collateral or margin paid - variation" {
    outflow = input
  }

  item "4.4" "Collateral or margin received - variation" {
    outflow = input
  }

  item "5" "LCR/MLH ratio over five business days" {}

  item "5.1" "Level 1/Domestic books – AUD (LCR ADIs only)" {
    day1 = input
    day2 = input
    day3 = input
    day4 = input
    day5 = input
  }

  item "5.2" "Level 1/Domestic books – all currencies (LCR and MLH ADIs)" {
    day1 = input
    day2 = input
    day3 = input
    day4 = input
    day5 = input
  }

  item "5.3" "Level 2 – AUD (LCR ADIs only)" {
    day1 = input
    day2 = input
    day3 = input
    day4 = input
    day5 = input
  }

  item "5.4" "Level 2 – all currencies (LCR and MLH ADIs)" {
    day1 = input
    day2 = input
    day3 = input
    day4 = input
    day5 = input
  }

  item "6" "Funding maturities" {}

  item "6.1" "Retail deposits (including SME)" {
    at_call = input
    d7      = input
    d15     = input
    d30     = input
    m2      = input
    m3      = input
    m4      = input
    m5      = input
    m6      = input
    total   = [6.1:at_call] + [6.1:d7] + [6.1:d15] + [6.1:d30] + [6.1:m2] + [6.1:m3] + [6.1:m4] + [6.1:m5] + [6.1:m6]
  }

