// Prudence form spec. Source of truth: edit this file, not code.
// Source: ARS 210.0 (F2023L00417) forms and instructions; APS 210 (July 2025).
// Format with: cargo run -p arf210 -- fmt <form>

@reporting("ARS 210.0", version: "2023-03-31")
form Arf210_5("ARF 210.5", "Daily Liquidity Report") {
  columns balance, prior, change, change_pct, outflow, outflow_pct, undrawn, day1, day2, day3, day4, day5, total, at_call, d7, d15, d30, m2, m3, m4, m5, m6, number, amount, amount_pct
  input balance

  item "1" "Unencumbered liquid assets" {}

  item "1.1" "HQLA" {
    balance    = input
    prior      = input
    change     = [1.1:balance] - [1.1:prior]
    change_pct = if [1.1:prior] == 0 then 0 else 100 * [1.1:change] / [1.1:prior]
  }

  item "1.2" "RBA eligible securities not included in item 1.1 and item 1.3" {
    balance    = input
    prior      = input
    change     = [1.2:balance] - [1.2:prior]
    change_pct = if [1.2:prior] == 0 then 0 else 100 * [1.2:change] / [1.2:prior]
  }

  item "1.3" "RBA eligible securities from self-securitisation" {
    balance    = input
    prior      = input
    change     = [1.3:balance] - [1.3:prior]
    change_pct = if [1.3:prior] == 0 then 0 else 100 * [1.3:change] / [1.3:prior]
  }

  item "1.4" "Other liquids (LCR ADIs)" {
    balance    = input
    prior      = input
    change     = [1.4:balance] - [1.4:prior]
    change_pct = if [1.4:prior] == 0 then 0 else 100 * [1.4:change] / [1.4:prior]
  }

  item "1.5" "Other liquids (non-LCR ADIs)" {
    balance    = input
    prior      = input
    change     = [1.5:balance] - [1.5:prior]
    change_pct = if [1.5:prior] == 0 then 0 else 100 * [1.5:change] / [1.5:prior]
  }

  item "1.6" "Total" {
    balance    = [1.1:balance] + [1.2:balance] + [1.3:balance] + [1.4:balance] + [1.5:balance]
    prior      = [1.1:prior] + [1.2:prior] + [1.3:prior] + [1.4:prior] + [1.5:prior]
    change     = [1.6:balance] - [1.6:prior]
    change_pct = if [1.6:prior] == 0 then 0 else 100 * [1.6:change] / [1.6:prior]
  } @cite("ARS p.129: sum of items 1.1 to 1.5")

  item "1.6.1" "of which: offshore liquid assets" {
    balance    = input
    prior      = input
    change     = [1.6.1:balance] - [1.6.1:prior]
    change_pct = if [1.6.1:prior] == 0 then 0 else 100 * [1.6.1:change] / [1.6.1:prior]
  }

  item "2" "Net funding outflows over last five business days" {}

  item "2.1" "Total retail deposit (including SME) outflow balance" {
    balance    = input
    prior      = input
    change     = [2.1:balance] - [2.1:prior]
    change_pct = if [2.1:prior] == 0 then 0 else 100 * [2.1:change] / [2.1:prior]
  }

  item "2.1.1" "of which: offshore" {
    balance    = input
    prior      = input
    change     = [2.1.1:balance] - [2.1.1:prior]
    change_pct = if [2.1.1:prior] == 0 then 0 else 100 * [2.1.1:change] / [2.1.1:prior]
  }

  item "2.2" "Total wholesale (non-financial institution) deposit balance" {
    balance    = input
    prior      = input
    change     = [2.2:balance] - [2.2:prior]
    change_pct = if [2.2:prior] == 0 then 0 else 100 * [2.2:change] / [2.2:prior]
  }

  item "2.2.1" "of which: offshore" {
    balance    = input
    prior      = input
    change     = [2.2.1:balance] - [2.2.1:prior]
    change_pct = if [2.2.1:prior] == 0 then 0 else 100 * [2.2.1:change] / [2.2.1:prior]
  }

  item "2.3" "Total financial institution deposit balance" {
    balance    = input
    prior      = input
    change     = [2.3:balance] - [2.3:prior]
    change_pct = if [2.3:prior] == 0 then 0 else 100 * [2.3:change] / [2.3:prior]
  }

  item "2.3.1" "of which: offshore" {
    balance    = input
    prior      = input
    change     = [2.3.1:balance] - [2.3.1:prior]
    change_pct = if [2.3.1:prior] == 0 then 0 else 100 * [2.3.1:change] / [2.3.1:prior]
  }

  item "2.4" "Total short-term wholesale funding balance not included above" {
    balance    = input
    prior      = input
    change     = [2.4:balance] - [2.4:prior]
    change_pct = if [2.4:prior] == 0 then 0 else 100 * [2.4:change] / [2.4:prior]
  }

  item "2.4.1" "of which: offshore" {
    balance    = input
    prior      = input
    change     = [2.4.1:balance] - [2.4.1:prior]
    change_pct = if [2.4.1:prior] == 0 then 0 else 100 * [2.4.1:change] / [2.4.1:prior]
  }

  item "2.5" "Total other wholesale funding balance not included above" {
    balance    = input
    prior      = input
    change     = [2.5:balance] - [2.5:prior]
    change_pct = if [2.5:prior] == 0 then 0 else 100 * [2.5:change] / [2.5:prior]
  }

  item "2.5.1" "of which: offshore" {
    balance    = input
    prior      = input
    change     = [2.5.1:balance] - [2.5.1:prior]
    change_pct = if [2.5.1:prior] == 0 then 0 else 100 * [2.5.1:change] / [2.5.1:prior]
  }

  item "2.6" "Total funding balance" {
    balance    = [2.1:balance] + [2.2:balance] + [2.3:balance] + [2.4:balance] + [2.5:balance]
    prior      = [2.1:prior] + [2.2:prior] + [2.3:prior] + [2.4:prior] + [2.5:prior]
    change     = [2.6:balance] - [2.6:prior]
    change_pct = if [2.6:prior] == 0 then 0 else 100 * [2.6:change] / [2.6:prior]
  } @cite("ARS p.130: sum of items 2.1 to 2.5")

  item "2.6.1" "of which: offshore" {
    balance    = [2.1.1:balance] + [2.2.1:balance] + [2.3.1:balance] + [2.4.1:balance] + [2.5.1:balance]
    prior      = [2.1.1:prior] + [2.2.1:prior] + [2.3.1:prior] + [2.4.1:prior] + [2.5.1:prior]
    change     = [2.6.1:balance] - [2.6.1:prior]
    change_pct = if [2.6.1:prior] == 0 then 0 else 100 * [2.6.1:change] / [2.6.1:prior]
  } @cite("ARS p.130: sum of items 2.1.1 to 2.5.1")

  item "3" "Net contingent and committed outflows over last five business days" {}

  item "3.1" "Net loan principal outflows" {
    outflow     = input
    outflow_pct = input
    undrawn     = input
  }

  item "3.2" "Net outflows under any uncommitted facilities" {
    outflow     = input
    outflow_pct = input
    undrawn     = input
  }

  item "3.3" "Net outflows under committed liquidity facilities" {
