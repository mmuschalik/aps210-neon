    total   = [6.3:at_call] + [6.3:d7] + [6.3:d15] + [6.3:d30] + [6.3:m2] + [6.3:m3] + [6.3:m4] + [6.3:m5] + [6.3:m6]
  }

  item "6.3.1" "of which: offshore" {
    at_call = input
