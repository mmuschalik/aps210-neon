  }

  item "6.7" "Total" {
    at_call = [6.1:at_call] + [6.2:at_call] + [6.3:at_call] + [6.4:at_call] + [6.5:at_call] + [6.6:at_call]
    d7      = [6.1:d7] + [6.2:d7] + [6.3:d7] + [6.4:d7] + [6.5:d7] + [6.6:d7]
