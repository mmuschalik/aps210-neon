    m6      = input
    total   = [6.1.1:at_call] + [6.1.1:d7] + [6.1.1:d15] + [6.1.1:d30] + [6.1.1:m2] + [6.1.1:m3] + [6.1.1:m4] + [6.1.1:m5] + [6.1.1:m6]
