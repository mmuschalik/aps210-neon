inductive Mode where
  | Conservative
  | Optimistic
  deriving DecidableEq, Repr, Inhabited

/-- `Uncertain<T>` -/
inductive U (α : Type) where
  | known (a : α)
  | unknown
  deriving DecidableEq, Repr, Inhabited

def U.map {α β : Type} (f : α → β) : U α → U β
  | .known a => .known (f a)
  | .unknown => .unknown

/-- `conservative(x, worst: w, best: b)` -/
def resolve {α : Type} (m : Mode) (x : U α) (worst best : α) : α :=
  match x with
  | .known a => a
  | .unknown => match m with
    | .Conservative => worst
    | .Optimistic => best

/-- Ordered comparison where an absent optional date compares false. -/
class ToOpt (α : Type) where
  toOpt : α → Option Int
instance : ToOpt Int := ⟨some⟩
instance : ToOpt (Option Int) := ⟨id⟩
instance : ToOpt Nat := ⟨fun n => some (n : Int)⟩
def pcmp {α β : Type} [ToOpt α] [ToOpt β] (r : Int → Int → Prop) [DecidableRel r] (a : α) (b : β) : Bool :=
  match ToOpt.toOpt a, ToOpt.toOpt b with
  | some x, some y => decide (r x y)
  | _, _ => false

abbrev GroupId := Nat
abbrev ProductClass := Nat

inductive Kind where
  | NonFinancialCorporate
  | SovereignCentralBankPseMdb
  | Bank
  | OtherFinancialInstitution
  | OtherLegalEntity
  deriving DecidableEq, Repr, Inhabited

structure Customer where
  kind : Kind
  -- deposits: world function W.Customer_deposits (would make records cyclic)
  deriving DecidableEq, Repr, Inhabited

structure Deposit where
  holder : Customer
  balance : Int
  within_30_days : Bool
  called : Bool
  fcs_eligible : U (Bool)
  operational_service : U (Bool)
  operational_balance : U (Int)
  maturity : Option Int := none
  deriving DecidableEq, Repr, Inhabited

/-- Everything the rules read that is not computed here. -/
structure World where
  reporting_date : Int
  fcs_limit : Int
  insured : Mode → Deposit → Int  -- optimize solution
  Customer_deposits : Customer → List (Deposit)  -- cyclic record field
  m6 : Int := 0
  m12 : Int := 0

def operational_amount (W : World) (m : Mode) (d : Deposit) : Int :=
  (if (resolve m d.operational_service false (!false)) then (min d.balance (resolve m d.operational_balance (0 : Int) d.balance)) else (0 : Int))

def entirely_insured (W : World) (m : Mode) (c : Customer) : Bool :=
  ((List.all (W.Customer_deposits c) (fun x => (resolve m x.fcs_eligible false (!false)))) && (pcmp (· ≤ ·) (List.foldr (· + ·) 0 (List.map (fun x => x.balance) (W.Customer_deposits c))) W.fcs_limit))

def «prefix» (W : World) (m : Mode) (c : Customer) : String :=
  (match c.kind with
    | .NonFinancialCorporate => "9.2"
    | .SovereignCentralBankPseMdb => "9.3"
    | .Bank => "9.4"
    | .OtherFinancialInstitution => "9.5"
    | .OtherLegalEntity => "9.5")

/-- The `partition` portion of `d` for the split flags operational, covered. -/
def portion (W : World) (m : Mode) (d : Deposit) (operational : Bool) (covered : Bool) : Int :=
  let p0 := d.balance
  let p1 := if operational then (operational_amount W m d) else p0 - ((operational_amount W m d))
  let p2 := if covered then (if operational then ((W.insured m) d) else (0 : Int)) else p1 - ((if operational then ((W.insured m) d) else (0 : Int)))
  p2

def out_lcr (W : World) (m : Mode) (d : Deposit) (operational : Bool) (covered : Bool) : Option String :=
  if ((!d.within_30_days) && (!d.called)) then
    none
  else if ((d.within_30_days || d.called) && d.called) then
    (match d.holder.kind with
    | .NonFinancialCorporate => "9.2.7"
    | .SovereignCentralBankPseMdb => "9.3.6"
    | .Bank => "9.4.5"
    | _ => "9.5.5")
  else if ((d.within_30_days && (!d.called)) && operational) then
    (match d.holder.kind with
    | .SovereignCentralBankPseMdb => (if covered then "9.3.1" else "9.3.3")
    | _ => (if covered then ((«prefix» W m d.holder) ++ ".2") else ((«prefix» W m d.holder) ++ ".4")))
  else 
    -- remaining case (exhaustive by the Z3 obligation): ((d.within_30_days && (!d.called)) && (!operational))
    (match d.holder.kind with
    | .NonFinancialCorporate => (if (entirely_insured W m d.holder) then "9.2.5" else "9.2.6")
    | .SovereignCentralBankPseMdb => (if (entirely_insured W m d.holder) then "9.3.4" else "9.3.5")
    | .Bank => "9.4.5"
    | _ => "9.5.5")

