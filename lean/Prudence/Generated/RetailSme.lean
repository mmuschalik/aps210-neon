/-- Arf210_1A measure of `d` (Column-2 weights, percent of the amount). -/
def measure_Arf210_1A (W : World) (m : Mode) (d : Deposit) : Int :=
  weight_Arf210_1A (out_lcr W m d true) * portion W m d true
    + weight_Arf210_1A (out_lcr W m d false) * portion W m d false

def out_nsfr (W : World) (m : Mode) (d : Deposit) (covered : Bool) : String × Nat :=
  if (List.contains [Class.Retail, Class.RetailLessStable, Class.SmeRetail] («class» W m d.holder)) then
    let p := (if ((«class» W m d.holder) == Class.SmeRetail) then "9.1" else "8")
    ((if ((stability W m d covered) == Stability.Stable) then "3" else "5"), (W.bucket (earliest_redemption W m d)))
  else if ((«class» W m d.holder) == .NonFinancialCorporate) then
    let insured := ((List.all (W.Customer_deposits d.holder) (fun x => (resolve m x.fcs_eligible false (!false)))) && (pcmp (· ≤ ·) (List.foldr (· + ·) 0 (List.map (fun x => x.balance) (W.Customer_deposits d.holder))) W.fcs_limit))
    ("9", (W.bucket (earliest_redemption W m d)))
  else 
    -- remaining case (exhaustive by the Z3 obligation): ((«class» W m d.holder) == .FinancialInstitution)
    ("12", (W.bucket (earliest_redemption W m d)))

