set_option match.ignoreUnusedAlts true

namespace RetailAndSmeDeposits

inductive Mode where
  | Conservative
  | Optimistic
  deriving DecidableEq, Repr, Inhabited

/-- `Uncertain<T>` -/
inductive U (α : Type) where
  | known (a : α)
  | unknown
  deriving DecidableEq, Repr, Inhabited

def U.map {α β : Type} (f : α → β) : U α → U β
  | .known a => .known (f a)
  | .unknown => .unknown

/-- `conservative(x, worst: w, best: b)` -/
def resolve {α : Type} (m : Mode) (x : U α) (worst best : α) : α :=
  match x with
  | .known a => a
  | .unknown => match m with
    | .Conservative => worst
    | .Optimistic => best

/-- Ordered comparison where an absent optional date compares false. -/
class ToOpt (α : Type) where
  toOpt : α → Option Int
instance : ToOpt Int := ⟨some⟩
instance : ToOpt (Option Int) := ⟨id⟩
instance : ToOpt Nat := ⟨fun n => some (n : Int)⟩
def pcmp {α β : Type} [ToOpt α] [ToOpt β] (r : Int → Int → Prop) [DecidableRel r] (a : α) (b : β) : Bool :=
  match ToOpt.toOpt a, ToOpt.toOpt b with
  | some x, some y => decide (r x y)
  | _, _ => false

abbrev GroupId := Nat
abbrev ProductClass := Nat

/-- The interpreter's name of an NSFR maturity bucket. -/
def bucketName : Nat → String
  | 0 => "b0"
  | 1 => "b1"
  | _ => "b2"

inductive Class where
  | Retail
  | RetailLessStable
  | SmeRetail
  | NonFinancialCorporate
  | FinancialInstitution
  deriving DecidableEq, Repr, Inhabited

inductive Horizon where
  | Demand
  | Called
  | Excluded
  deriving DecidableEq, Repr, Inhabited

inductive Kind where
  | NaturalPerson
  | Smsf
  | PersonalInvestmentEntity
  | Sme
  | NonFinancialCorporate
  | FinancialInstitution
  deriving DecidableEq, Repr, Inhabited

inductive Stability where
  | Stable
  | LessStable
  | HigherRunOff
  deriving DecidableEq, Repr, Inhabited

inductive WithdrawalTerms where
  | NoLegalRight
  | SignificantPenalty
  | Permitted
  deriving DecidableEq, Repr, Inhabited

structure Customer where
  kind : Kind
  established_relationship : U (Bool)
  sme_group : U (GroupId)
  managed_as_retail : U (Bool)
  pie_qualifies : U (Bool)
  -- deposits: world function W.Customer_deposits (would make records cyclic)
  deriving DecidableEq, Repr, Inhabited

inductive Contract_Deposit where
  | CLM (notice_days : Int) (grace_end : Option (Int))
  | PAM (maturity : Int) (early_withdrawal : U (WithdrawalTerms))
  | UMP
  deriving DecidableEq, Repr, Inhabited

structure Deposit where
  holder : Customer
  product_class : ProductClass
  balance : Int
  fcs_eligible : U (Bool)
  transactional : U (Bool)
  online : U (Bool)
  rate_driven : U (Bool)
  contract : Contract_Deposit
  deriving DecidableEq, Repr, Inhabited

structure EarlyWithdrawal where
  product_class : ProductClass
  hardship : Bool
  valid : Int
  recorded : Int
  deriving DecidableEq, Repr, Inhabited

structure NoticeGiven where
  deposit : Deposit
  repayment : Int
  valid : Int
  recorded : Int
  deriving DecidableEq, Repr, Inhabited

structure SmeGroups_row where
  total : Int
  deriving Repr, Inhabited

/-- Everything the rules read that is not computed here. -/
structure World where
  reporting_date : Int
  known_at : Int
  fcs_limit : Int
  sme_threshold : Int
  SmeGroups : Mode → Option (GroupId) → SmeGroups_row  -- view
  Tainted : List (ProductClass)  -- view
  covered : Mode → Deposit → Int  -- optimize solution
  Customer_deposits : Customer → List (Deposit)  -- cyclic record field
  bucket : Int → Nat  -- NSFR maturity bucket of a date (built-in)
  solo : Customer → GroupId  -- the group of just one Customer (built-in)
  latest_notice : Deposit → Option (NoticeGiven)  -- fn over events/views: built-in `latest` is not compiled

def «class» (W : World) (m : Mode) (c : Customer) : Class :=
  (match c.kind with
    | .NaturalPerson => Class.Retail
    | .Smsf => Class.RetailLessStable
    | .PersonalInvestmentEntity => (if (resolve m c.pie_qualifies false (!false)) then Class.RetailLessStable else .FinancialInstitution)
    | .Sme => (let g := (resolve m (U.map some c.sme_group) none (some (W.solo c)))
    (if (((resolve m c.managed_as_retail false (!false)) && (g != none)) && (pcmp (· < ·) ((W.SmeGroups m) g).total W.sme_threshold)) then Class.SmeRetail else .NonFinancialCorporate))
    | .NonFinancialCorporate => .NonFinancialCorporate
    | .FinancialInstitution => .FinancialInstitution)

def horizon (W : World) (m : Mode) (d : Deposit) : Horizon :=
  (match d.contract with
    | .UMP => Horizon.Demand
    | .CLM n grace_end => (if (pcmp (· ≥ ·) grace_end W.reporting_date) then Horizon.Demand else (match (W.latest_notice d) with
    | some ⟨_, r, _, _⟩ => (if (pcmp (· ≤ ·) (r - W.reporting_date) (30 : Int)) then Horizon.Called else Horizon.Excluded)
    | _ => (if (pcmp (· ≥ ·) n (31 : Int)) then Horizon.Excluded else Horizon.Demand)))
    | .PAM maturity ew => (let w := (resolve m ew WithdrawalTerms.Permitted WithdrawalTerms.NoLegalRight)
    (if (pcmp (· ≤ ·) (maturity - W.reporting_date) (30 : Int)) then Horizon.Demand else (if ((w == WithdrawalTerms.Permitted) || ((w == WithdrawalTerms.NoLegalRight) && (List.contains W.Tainted d.product_class))) then Horizon.Demand else Horizon.Excluded))))

def earliest_redemption (W : World) (m : Mode) (d : Deposit) : Int :=
  (match d.contract with
    | .UMP => W.reporting_date
    | .CLM n grace_end => (if (pcmp (· ≥ ·) grace_end W.reporting_date) then W.reporting_date else (match (W.latest_notice d) with
    | some ⟨_, r, _, _⟩ => r
    | _ => (W.reporting_date + n)))
    | .PAM maturity ew => (let w := (resolve m ew WithdrawalTerms.Permitted WithdrawalTerms.NoLegalRight)
    (if (((w == WithdrawalTerms.Permitted) || ((w == WithdrawalTerms.NoLegalRight) && (List.contains W.Tainted d.product_class))) || (pcmp (· < ·) maturity W.reporting_date)) then W.reporting_date else maturity)))

def score (W : World) (m : Mode) (d : Deposit) (covered : Bool) : Int :=
  ((((if (!covered) then (2 : Int) else (0 : Int)) + (if (resolve m d.online true (!true)) then (2 : Int) else (0 : Int))) + (if (!(resolve m d.holder.established_relationship false (!false))) then (1 : Int) else (0 : Int))) + (if (resolve m d.rate_driven true (!true)) then (1 : Int) else (0 : Int)))

def stability (W : World) (m : Mode) (d : Deposit) (covered : Bool) : Stability :=
  (if ((covered && ((«class» W m d.holder) != Class.RetailLessStable)) && ((resolve m d.holder.established_relationship false (!false)) || (resolve m d.transactional false (!false)))) then Stability.Stable else (if (pcmp (· ≥ ·) (score W m d covered) (3 : Int)) then Stability.HigherRunOff else Stability.LessStable))

def lcr_rate (W : World) (m : Mode) (d : Deposit) (covered : Bool) : Int :=
  (match (horizon W m d) with
    | .Excluded => (0 : Int)
    | .Called => (100 : Int)
    | .Demand => (match (stability W m d covered) with
    | .Stable => (5 : Int)
    | .LessStable => (10 : Int)
    | .HigherRunOff => (25 : Int)))

/-- The `partition` portion of `d` for the split flags covered. -/
def portion (W : World) (m : Mode) (d : Deposit) (covered : Bool) : Int :=
  if covered then ((W.covered m) d) else d.balance - ((W.covered m) d)

def out_lcr (W : World) (m : Mode) (d : Deposit) (covered : Bool) : Option String :=
  if (List.contains [Class.Retail, Class.RetailLessStable, Class.SmeRetail] («class» W m d.holder)) then
    let p := (if ((«class» W m d.holder) == Class.SmeRetail) then "9.1" else "8")
    (match ((horizon W m d), (stability W m d covered)) with
    | (.Excluded, _) => none
    | (.Called, _) => (p ++ ".6")
    | (.Demand, .Stable) => (p ++ ".1")
    | (.Demand, .LessStable) => if covered then (p ++ ".3") else (match ((horizon W m d), (stability W m d covered)) with
    | (.Demand, .LessStable) => (p ++ ".4")
    | (.Demand, .HigherRunOff) => (p ++ ".5")
    | _ => default)
    | (.Demand, .HigherRunOff) => (p ++ ".5"))
  else if ((«class» W m d.holder) == .NonFinancialCorporate) then
    let insured := ((List.all (W.Customer_deposits d.holder) (fun x => (resolve m x.fcs_eligible false (!false)))) && (pcmp (· ≤ ·) (List.foldr (· + ·) 0 (List.map (fun x => x.balance) (W.Customer_deposits d.holder))) W.fcs_limit))
    (match (horizon W m d) with
    | .Excluded => none
    | .Called => "9.2.7"
    | .Demand => (if insured then "9.2.5" else "9.2.6"))
  else 
    -- remaining case (exhaustive by the Z3 obligation): ((«class» W m d.holder) == .FinancialInstitution)
    (if ((horizon W m d) == Horizon.Excluded) then none else "9.5.5")

