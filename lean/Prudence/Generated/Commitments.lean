/-
  GENERATED by `lake exe prudence-export` from `Prudence.Specs.Modules` (`Commitments`). Do not edit.
-/
set_option autoImplicit false
set_option linter.unusedVariables false
set_option match.ignoreUnusedAlts true

namespace Commitments

inductive Mode where
  | Conservative
  | Optimistic
  deriving DecidableEq, Repr, Inhabited

/-- `Uncertain<T>` -/
inductive U (α : Type) where
  | known (a : α)
  | unknown
  deriving DecidableEq, Repr, Inhabited

def U.map {α β : Type} (f : α → β) : U α → U β
  | .known a => .known (f a)
  | .unknown => .unknown

/-- `conservative(x, worst: w, best: b)` -/
def resolve {α : Type} (m : Mode) (x : U α) (worst best : α) : α :=
  match x with
  | .known a => a
  | .unknown => match m with
    | .Conservative => worst
    | .Optimistic => best

/-- Ordered comparison where an absent optional date compares false. -/
class ToOpt (α : Type) where
  toOpt : α → Option Int
instance : ToOpt Int := ⟨some⟩
instance : ToOpt (Option Int) := ⟨id⟩
instance : ToOpt Nat := ⟨fun n => some (n : Int)⟩
def pcmp {α β : Type} [ToOpt α] [ToOpt β] (r : Int → Int → Prop) [DecidableRel r] (a : α) (b : β) : Bool :=
  match ToOpt.toOpt a, ToOpt.toOpt b with
  | some x, some y => decide (r x y)
  | _, _ => false

abbrev GroupId := Nat
abbrev ProductClass := Nat

inductive Counterparty where
  | RetailCustomer
  | Sme
  | NonFinancialCorporate
  | SovereignCentralBankPseMdb
  | RegulatedBank
  | OtherFinancialInstitution
  | OtherLegalEntity
  deriving DecidableEq, Repr, Inhabited

inductive FacilityKind where
  | CreditFacility
  | LiquidityFacility
  deriving DecidableEq, Repr, Inhabited

inductive ObligationKind where
  | TradeFinance
  | Guarantee
  | ShortTermDebtBuyback
  | LongTermDebtBuyback
  | AffiliatedDealerBuyback
  | StructuredProductsAndFunds
  | OtherNonContractual
  | OtherContractual
  deriving DecidableEq, Repr, Inhabited

structure ContingentObligation where
  kind : ObligationKind
  amount : Int
  deriving DecidableEq, Repr, Inhabited

structure Facility where
  counterparty : Counterparty
  kind : FacilityKind
  committed : Bool
  undrawn : Int
  drawable_within_30_days : U (Bool)
  mortgage_redraw : Bool
  funds_vehicle : Bool
  deriving DecidableEq, Repr, Inhabited

structure LendingCommitment where
  counterparty : Counterparty
  amount : Int
  deriving DecidableEq, Repr, Inhabited

/-- Everything the rules read that is not computed here. -/
structure World where
  reporting_date : Int

def facility_row (W : World) (m : Mode) (f : Facility) : String :=
  (if (!(resolve m f.drawable_within_30_days true (!true))) then "none" else (if (!(f.committed || f.mortgage_redraw)) then "16.1" else (if f.funds_vehicle then "14.6.2" else (match f.counterparty with
    | .RetailCustomer => "14.1.1"
    | .Sme => "14.2.1"
    | .NonFinancialCorporate => (if (f.kind == FacilityKind.CreditFacility) then "14.3.1" else "14.3.2")
    | .SovereignCentralBankPseMdb => (if (f.kind == FacilityKind.CreditFacility) then "14.4.1" else "14.4.2")
    | .RegulatedBank => "14.5.1"
    | .OtherFinancialInstitution => (if (f.kind == FacilityKind.CreditFacility) then "14.6.1" else "14.6.2")
    | .OtherLegalEntity => "14.7.1"))))

def facility (W : World) (m : Mode) (f : Facility) (i : String) : Int :=
  (if (i == (facility_row W m f)) then f.undrawn else (0 : Int))

def commitment_row (W : World) (m : Mode) (c : LendingCommitment) : String :=
  (match c.counterparty with
    | .RegulatedBank => "15.1"
    | .OtherFinancialInstitution => "15.1"
    | .RetailCustomer => "15.2"
    | .Sme => "15.3"
    | .NonFinancialCorporate => "15.4"
    | .SovereignCentralBankPseMdb => "15.5"
    | .OtherLegalEntity => "15.5")

def commitment (W : World) (m : Mode) (c : LendingCommitment) (i : String) : Int :=
  (if (i == (commitment_row W m c)) then c.amount else (0 : Int))

def obligation_row (W : World) (m : Mode) (o : ContingentObligation) : String :=
  (match o.kind with
    | .TradeFinance => "16.2"
    | .Guarantee => "16.3"
    | .ShortTermDebtBuyback => "16.4"
    | .LongTermDebtBuyback => "16.5"
    | .AffiliatedDealerBuyback => "16.6"
    | .StructuredProductsAndFunds => "16.7"
    | .OtherNonContractual => "16.8"
    | .OtherContractual => "16.9")

def obligation (W : World) (m : Mode) (o : ContingentObligation) (i : String) : Int :=
  (if (i == (obligation_row W m o)) then o.amount else (0 : Int))

end Commitments
