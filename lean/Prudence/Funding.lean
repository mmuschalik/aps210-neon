set_option autoImplicit false
set_option linter.unusedVariables false
set_option match.ignoreUnusedAlts true

namespace FundingAndPlacements

inductive Mode where
  | Conservative
  | Optimistic
  deriving DecidableEq, Repr, Inhabited

/-- `Uncertain<T>` -/
inductive U (α : Type) where
  | known (a : α)
  | unknown
  deriving DecidableEq, Repr, Inhabited

def U.map {α β : Type} (f : α → β) : U α → U β
  | .known a => .known (f a)
  | .unknown => .unknown

/-- `conservative(x, worst: w, best: b)` -/
def resolve {α : Type} (m : Mode) (x : U α) (worst best : α) : α :=
  match x with
  | .known a => a
  | .unknown => match m with
    | .Conservative => worst
    | .Optimistic => best

/-- Ordered comparison where an absent optional date compares false. -/
class ToOpt (α : Type) where
  toOpt : α → Option Int
instance : ToOpt Int := ⟨some⟩
instance : ToOpt (Option Int) := ⟨id⟩
instance : ToOpt Nat := ⟨fun n => some (n : Int)⟩
def pcmp {α β : Type} [ToOpt α] [ToOpt β] (r : Int → Int → Prop) [DecidableRel r] (a : α) (b : β) : Bool :=
  match ToOpt.toOpt a, ToOpt.toOpt b with
  | some x, some y => decide (r x y)
  | _, _ => false

abbrev GroupId := Nat
abbrev ProductClass := Nat

/-- Days since 1970-01-01 of a proleptic Gregorian date. -/
def daysFromCivil (y m d : Int) : Int :=
  let y := if m ≤ 2 then y - 1 else y
  let era := Int.tdiv (if y ≥ 0 then y else y - 399) 400
  let yoe := y - era * 400
  let doy := Int.tdiv (153 * (if m > 2 then m - 3 else m + 9) + 2) 5 + d - 1
  let doe := yoe * 365 + Int.tdiv yoe 4 - Int.tdiv yoe 100 + doy
  era * 146097 + doe - 719468

def civilFromDays (z : Int) : Int × Int × Int :=
  let z := z + 719468
  let era := Int.tdiv (if z ≥ 0 then z else z - 146096) 146097
  let doe := z - era * 146097
  let yoe := Int.tdiv (doe - Int.tdiv doe 1460 + Int.tdiv doe 36524 - Int.tdiv doe 146096) 365
  let y := yoe + era * 400
  let doy := doe - (365 * yoe + Int.tdiv yoe 4 - Int.tdiv yoe 100)
  let mp := Int.tdiv (5 * doy + 2) 153
  let d := doy - Int.tdiv (153 * mp + 2) 5 + 1
  let m := if mp < 10 then mp + 3 else mp - 9
  (if m ≤ 2 then y + 1 else y, m, d)

def daysInMonth (y m : Int) : Int :=
  if m = 2 then (if (y % 4 = 0 ∧ y % 100 ≠ 0) ∨ y % 400 = 0 then 29 else 28)
  else if m = 4 ∨ m = 6 ∨ m = 9 ∨ m = 11 then 30 else 31

/-- `add_months`: shift by whole months, clamping the day to the month's length. -/
def addMonths (day months : Int) : Int :=
  match civilFromDays day with
  | (y, m, d) =>
    let total := (m - 1) + months
    let y2 := y + Int.ediv total 12
    let m2 := Int.emod total 12 + 1
    daysFromCivil y2 m2 (min d (daysInMonth y2 m2))

/-- ACTUS cycle: the payment numbers k ≥ 0 with addMonths start (k * months) ≤ upto
    (months have at least 28 days, so k ≤ (upto - start) / 28). -/
def cycle (start months upto : Int) : List Int :=
  ((List.range (Int.toNat ((upto - start) / 28 + 1))).map Int.ofNat).filter
    (fun k => decide (addMonths start (k * months) ≤ upto))

/-- The interpreter's name of an NSFR maturity bucket. -/
def bucketName : Nat → String
  | 0 => "b0"
  | 1 => "b1"
  | _ => "b2"

inductive AdiType where
  | MajorBank
  | LcrAdi
  | OtherAdi
  | ForeignAdi
  deriving DecidableEq, Repr, Inhabited

inductive SecurityKind where
  | ShortTerm
  | EuroCommercialPaper
  | UsCommercialPaper
  | LongTerm
  | CoveredBond
  | ShortTermSecuritisation
  | LongTermSecuritisation
  deriving DecidableEq, Repr, Inhabited

inductive Tier where
  | CET1
  | AT1
  | T2
  deriving DecidableEq, Repr, Inhabited

structure CapitalInstrument where
  tier : Tier
  amount : Int
  maturity : Option (Int)
  deriving DecidableEq, Repr, Inhabited

structure IssuedSecurity where
  kind : SecurityKind
  amount : Int
  maturity : Int
  offshore : Bool
  deriving DecidableEq, Repr, Inhabited

structure Placement where
  adi : AdiType
  amount : Int
  maturity : Option (Int)
  operational : U (Bool)
  deriving DecidableEq, Repr, Inhabited

/-- Everything the rules read that is not computed here. -/
structure World where
  reporting_date : Int
  bucket : Int → Nat  -- NSFR maturity bucket of a date (built-in)

def within_30 (W : World) (m : Mode) (d : Int) : Bool :=
  (pcmp (· ≤ ·) (d - W.reporting_date) (30 : Int))

def secured (W : World) (m : Mode) (s : IssuedSecurity) : Bool :=
  (List.contains [SecurityKind.CoveredBond, SecurityKind.ShortTermSecuritisation, SecurityKind.LongTermSecuritisation] s.kind)

def security_lcr_row (W : World) (m : Mode) (s : IssuedSecurity) : String :=
  (if (!(within_30 W m s.maturity)) then "none" else (if (secured W m s) then "12.1" else (if s.offshore then "10.2" else "10.1")))

def security_nsfr_item (W : World) (m : Mode) (s : IssuedSecurity) : String :=
  "12"

def security_bucket (W : World) (m : Mode) (s : IssuedSecurity) : String :=
  (bucketName (W.bucket s.maturity))

def capital_lcr_row (W : World) (m : Mode) (c : CapitalInstrument) : String :=
  (if ((c.tier == Tier.T2) && (pcmp (· ≤ ·) c.maturity (W.reporting_date + (30 : Int)))) then "10.1" else "none")

def capital_nsfr_item (W : World) (m : Mode) (c : CapitalInstrument) : String :=
  (if ((c.tier == Tier.T2) && (pcmp (· < ·) c.maturity (addMonths W.reporting_date (12 : Int)))) then "12" else "1")

def capital_bucket (W : World) (m : Mode) (c : CapitalInstrument) : String :=
  (if ((capital_nsfr_item W m c) == "1") then "b2" else (match c.maturity with
    | some m => (bucketName (W.bucket m))
    | _ => "b2"))

def operational (W : World) (m : Mode) (p : Placement) : Bool :=
  (resolve m p.operational true (!true))

def placement_lcr_row (W : World) (m : Mode) (p : Placement) : String :=
  (if (operational W m p) then "none" else (if ((p.maturity == none) || (pcmp (· ≤ ·) p.maturity (W.reporting_date + (30 : Int)))) then "20.5" else "none"))

def placement_nsfr_item (W : World) (m : Mode) (p : Placement) : String :=
  (if (operational W m p) then "33.1" else "24.1")

def placement_bucket (W : World) (m : Mode) (p : Placement) : String :=
  (match p.maturity with
    | some m => (bucketName (W.bucket m))
    | _ => "b0")

def placement_mlh_row (W : World) (m : Mode) (p : Placement) : String :=
  (s!"{(if (p.maturity == none) then "6.1" else "6.2")}.{(match p.adi with
    | .MajorBank => (1 : Int)
    | .LcrAdi => (2 : Int)
    | .OtherAdi => (3 : Int)
    | .ForeignAdi => (4 : Int))}")

end FundingAndPlacements
