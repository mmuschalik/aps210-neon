/-- Arf210_6 measure of `l` (factors, percent of the amount). -/
def measure_Arf210_6 (W : World) (m : Mode) (l : Loan) : Rat :=
  (factor_Arf210_6 (out_nsfr W m l true true) : Rat) * portion W m l true true
    + (factor_Arf210_6 (out_nsfr W m l true false) : Rat) * portion W m l true false
    + (factor_Arf210_6 (out_nsfr W m l false true) : Rat) * portion W m l false true
    + (factor_Arf210_6 (out_nsfr W m l false false) : Rat) * portion W m l false false

