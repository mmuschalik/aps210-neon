inductive Mode where
  | Conservative
  | Optimistic
  deriving DecidableEq, Repr, Inhabited

/-- `Uncertain<T>` -/
inductive U (α : Type) where
  | known (a : α)
  | unknown
  deriving DecidableEq, Repr, Inhabited

def U.map {α β : Type} (f : α → β) : U α → U β
  | .known a => .known (f a)
  | .unknown => .unknown

/-- `conservative(x, worst: w, best: b)` -/
def resolve {α : Type} (m : Mode) (x : U α) (worst best : α) : α :=
  match x with
  | .known a => a
  | .unknown => match m with
    | .Conservative => worst
    | .Optimistic => best

/-- Ordered comparison where an absent optional date compares false. -/
class ToOpt (α : Type) where
  toOpt : α → Option Int
instance : ToOpt Int := ⟨some⟩
instance : ToOpt (Option Int) := ⟨id⟩
instance : ToOpt Nat := ⟨fun n => some (n : Int)⟩
def pcmp {α β : Type} [ToOpt α] [ToOpt β] (r : Int → Int → Prop) [DecidableRel r] (a : α) (b : β) : Bool :=
  match ToOpt.toOpt a, ToOpt.toOpt b with
  | some x, some y => decide (r x y)
  | _, _ => false

abbrev GroupId := Nat
abbrev ProductClass := Nat

/-- Days since 1970-01-01 of a proleptic Gregorian date. -/
def daysFromCivil (y m d : Int) : Int :=
  let y := if m ≤ 2 then y - 1 else y
  let era := Int.tdiv (if y ≥ 0 then y else y - 399) 400
  let yoe := y - era * 400
  let doy := Int.tdiv (153 * (if m > 2 then m - 3 else m + 9) + 2) 5 + d - 1
  let doe := yoe * 365 + Int.tdiv yoe 4 - Int.tdiv yoe 100 + doy
  era * 146097 + doe - 719468

def civilFromDays (z : Int) : Int × Int × Int :=
  let z := z + 719468
  let era := Int.tdiv (if z ≥ 0 then z else z - 146096) 146097
  let doe := z - era * 146097
  let yoe := Int.tdiv (doe - Int.tdiv doe 1460 + Int.tdiv doe 36524 - Int.tdiv doe 146096) 365
  let y := yoe + era * 400
  let doy := doe - (365 * yoe + Int.tdiv yoe 4 - Int.tdiv yoe 100)
  let mp := Int.tdiv (5 * doy + 2) 153
  let d := doy - Int.tdiv (153 * mp + 2) 5 + 1
  let m := if mp < 10 then mp + 3 else mp - 9
  (if m ≤ 2 then y + 1 else y, m, d)

def daysInMonth (y m : Int) : Int :=
  if m = 2 then (if (y % 4 = 0 ∧ y % 100 ≠ 0) ∨ y % 400 = 0 then 29 else 28)
  else if m = 4 ∨ m = 6 ∨ m = 9 ∨ m = 11 then 30 else 31

/-- `add_months`: shift by whole months, clamping the day to the month's length. -/
def addMonths (day months : Int) : Int :=
  match civilFromDays day with
  | (y, m, d) =>
    let total := (m - 1) + months
    let y2 := y + Int.ediv total 12
    let m2 := Int.emod total 12 + 1
    daysFromCivil y2 m2 (min d (daysInMonth y2 m2))

/-- ACTUS cycle: the payment numbers k ≥ 0 with addMonths start (k * months) ≤ upto
    (months have at least 28 days, so k ≤ (upto - start) / 28). -/
def cycle (start months upto : Int) : List Int :=
  ((List.range (Int.toNat ((upto - start) / 28 + 1))).map Int.ofNat).filter
    (fun k => decide (addMonths start (k * months) ≤ upto))

def qpowN (x : Rat) : Nat → Rat
  | 0 => 1
  | n + 1 => qpowN x n * x

def qpow (x : Rat) (n : Int) : Rat :=
  if n ≥ 0 then qpowN x n.toNat else 1 / qpowN x (-n).toNat

inductive Affiliation where
  | External
  | IntraGroupBank
  | IntraGroupFinancial
  | IntraGroupOther
  deriving DecidableEq, Repr, Inhabited

inductive Borrower where
  | RetailCustomer
  | Sme
  | NonFinancialCorporate
  | CentralBank
  | FinancialInstitution
  | OtherEntity
  deriving DecidableEq, Repr, Inhabited

inductive Product where
  | ResidentialMortgage
  | OtherLoan
  deriving DecidableEq, Repr, Inhabited

inductive Contract_Loan where
  | ANN (payment : Rat)
  | LAM (principal_per_period : Rat)
  | PAM (maturity : Int)
  | UMP (minimum_payment : Rat)
  deriving DecidableEq, Repr, Inhabited

structure Loan where
  borrower : Borrower
  affiliation : Affiliation
  product : Product
  balance : Rat
  rate : Rat
  next_payment : Int
  cycle_months : Int
  performing : U (Bool)
  lvr_at_most_80 : U (Bool)
  risk_weight : Int
  encumbered_until : Option (Int)
  contract : Contract_Loan
  deriving DecidableEq, Repr, Inhabited

structure Receivable where
  amount : Rat
  due : Int
  non_financial_revenue : Bool
  contingent : Bool
  performing : U (Bool)
  deriving DecidableEq, Repr, Inhabited

/-- Everything the rules read that is not computed here. -/
structure World where
  reporting_date : Int
  foreign_adi : Bool
  local_banking_subsidiary : Bool
  head_office_approved : Bool
  head_office_facility : Rat

def period_rate (W : World) (m : Mode) (l : Loan) : Rat :=
  ((l.rate * l.cycle_months) / 12)

def outstanding (W : World) (m : Mode) (l : Loan) (n : Int) : Rat :=
  (match l.contract with
    | .LAM p => (max (0 : Rat) (l.balance - (p * n)))
    | .ANN a => (let g := (1 + (period_rate W m l))
    (if ((period_rate W m l) == 0) then (max (0 : Rat) (l.balance - (a * n))) else (max (0 : Rat) ((l.balance * (qpow g n)) - ((a * ((qpow g n) - 1)) / (period_rate W m l))))))
    | .PAM maturity => (if ((pcmp (· ≥ ·) n 1) && (pcmp (· ≥ ·) (addMonths l.next_payment ((n - 1) * l.cycle_months)) maturity)) then (0 : Rat) else l.balance)
    | .UMP m => l.balance)

def cash (W : World) (m : Mode) (l : Loan) (k : Int) : Rat :=
  (match l.contract with
    | .UMP m => (if (k == 0) then (min m l.balance) else (0 : Rat))
    | _ => (((outstanding W m l k) - (outstanding W m l (k + 1))) + ((outstanding W m l k) * (period_rate W m l))))

def last_payment_day (W : World) (m : Mode) (l : Loan) : Int :=
  (match l.contract with
    | .PAM maturity => maturity
    | _ => (W.reporting_date + 36500))

def inflow_30d (W : World) (m : Mode) (l : Loan) : Rat :=
  (if (!(resolve m l.performing false (!false))) then (0 : Rat) else (List.foldr (· + ·) 0 (List.map (fun k => (cash W m l k)) (cycle l.next_payment l.cycle_months (min (W.reporting_date + 30) (last_payment_day W m l))))))

def inflow_row (W : World) (m : Mode) (l : Loan) : String :=
  (match l.borrower with
    | .RetailCustomer => "20.1"
    | .Sme => "20.2"
    | .NonFinancialCorporate => "20.3"
    | .CentralBank => "20.4"
    | .FinancialInstitution => "20.5"
    | .OtherEntity => "20.6")

def intra_group_row (W : World) (m : Mode) (l : Loan) : String :=
  (match l.affiliation with
    | .External => "none"
    | .IntraGroupBank => "20.7"
    | .IntraGroupFinancial => "20.8"
    | .IntraGroupOther => "20.9")

def inflow (W : World) (m : Mode) (l : Loan) (i : String) : Rat :=
  (if ((i == (inflow_row W m l)) || (i == (intra_group_row W m l))) then (inflow_30d W m l) else (0 : Rat))

def other_inflow (W : World) (m : Mode) (r : Receivable) (i : String) : Rat :=
  (if ((((((i == "21.4") && (pcmp (· < ·) W.reporting_date r.due)) && (pcmp (· ≤ ·) r.due (W.reporting_date + 30))) && (!r.non_financial_revenue)) && (!r.contingent)) && (resolve m r.performing false (!false))) then r.amount else (0 : Rat))

def head_office_support (W : World) (m : Mode) : Rat :=
  (if ((W.foreign_adi && (!W.local_banking_subsidiary)) && W.head_office_approved) then W.head_office_facility else (0 : Rat))

def principal_before (W : World) (m : Mode) (l : Loan) (t : Int) : Rat :=
  (match l.contract with
    | .UMP m => (0 : Rat)
    | _ => (max (0 : Rat) (l.balance - (outstanding W m l (List.foldr (· + ·) 0 (List.map (fun k => 1) (cycle l.next_payment l.cycle_months (t - 1))))))))

def rsf_item (W : World) (m : Mode) (l : Loan) : String :=
  (if (!(resolve m l.performing false (!false))) then "39" else (if ((l.borrower == Borrower.FinancialInstitution) || (l.borrower == Borrower.CentralBank)) then "24" else (if ((l.product == Product.ResidentialMortgage) && (resolve m l.lvr_at_most_80 false (!false))) then "35" else (if (pcmp (· ≤ ·) l.risk_weight 35) then "36" else "37"))))

def sub_item (W : World) (m : Mode) (l : Loan) : String :=
  (if ((rsf_item W m l) == "39") then "39" else (if ((rsf_item W m l) == "24") then (if (pcmp (· ≥ ·) l.encumbered_until (addMonths W.reporting_date 12)) then "24.2.3" else (if (pcmp (· ≥ ·) l.encumbered_until (addMonths W.reporting_date 6)) then "24.2.2" else (if (pcmp (· > ·) l.encumbered_until W.reporting_date) then "24.2.1" else "24.1"))) else (if (pcmp (· ≥ ·) l.encumbered_until (addMonths W.reporting_date 12)) then (((rsf_item W m l) ++ ".2") ++ ".2") else (if (pcmp (· ≥ ·) l.encumbered_until (addMonths W.reporting_date 6)) then (((rsf_item W m l) ++ ".2") ++ ".1") else ((rsf_item W m l) ++ ".1")))))

/-- The `partition` portion of `l` for the split flags within_6m, within_1y. -/
def portion (W : World) (m : Mode) (l : Loan) (within_6m : Bool) (within_1y : Bool) : Rat :=
  let p0 := l.balance
  let p1 := if within_6m then (principal_before W m l (addMonths W.reporting_date 6)) else p0 - ((principal_before W m l (addMonths W.reporting_date 6)))
  let p2 := if within_1y then (if within_6m then (0 : Rat) else ((principal_before W m l (addMonths W.reporting_date 12)) - (principal_before W m l (addMonths W.reporting_date 6)))) else p1 - ((if within_6m then (0 : Rat) else ((principal_before W m l (addMonths W.reporting_date 12)) - (principal_before W m l (addMonths W.reporting_date 6)))))
  p2

def out_nsfr (W : World) (m : Mode) (l : Loan) (within_6m : Bool) (within_1y : Bool) : String × Nat :=
  if within_6m then
    ((sub_item W m l), (0 : Nat))
  else if ((!within_6m) && within_1y) then
    ((sub_item W m l), (1 : Nat))
  else 
    -- remaining case (exhaustive by the Z3 obligation): ((!within_6m) && (!within_1y))
    ((sub_item W m l), (2 : Nat))

