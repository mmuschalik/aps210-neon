namespace SecuredFunding

inductive Mode where
  | Conservative
  | Optimistic
  deriving DecidableEq, Repr, Inhabited

/-- `Uncertain<T>` -/
inductive U (α : Type) where
  | known (a : α)
  | unknown
  deriving DecidableEq, Repr, Inhabited

def U.map {α β : Type} (f : α → β) : U α → U β
  | .known a => .known (f a)
  | .unknown => .unknown

/-- `conservative(x, worst: w, best: b)` -/
def resolve {α : Type} (m : Mode) (x : U α) (worst best : α) : α :=
  match x with
  | .known a => a
  | .unknown => match m with
    | .Conservative => worst
    | .Optimistic => best

/-- Ordered comparison where an absent optional date compares false. -/
class ToOpt (α : Type) where
  toOpt : α → Option Int
instance : ToOpt Int := ⟨some⟩
instance : ToOpt (Option Int) := ⟨id⟩
def pcmp {α β : Type} [ToOpt α] [ToOpt β] (r : Int → Int → Prop) [DecidableRel r] (a : α) (b : β) : Bool :=
  match ToOpt.toOpt a, ToOpt.toOpt b with
  | some x, some y => decide (r x y)
  | _, _ => false

abbrev GroupId := Nat
abbrev ProductClass := Nat

inductive Counterparty where
  | OffshoreCentralBank
  | DomesticSovereignOrPse
  | OtherCounterparty
  deriving DecidableEq, Repr, Inhabited

inductive HqlaClass where
  | HQLA1
  | HQLA2A
  | RmbsHqla2B
  | NonRmbsHqla2B
  | NonHqla
  deriving DecidableEq, Repr, Inhabited

inductive Leg where
  | Funding
  | Lending
  deriving DecidableEq, Repr, Inhabited

inductive Contract_Repo where
  | REP (maturity : Int)
  deriving DecidableEq, Repr, Inhabited

structure Repo where
  leg : Leg
  cash : Int
  collateral_class : HqlaClass
  collateral_value : Int
  counterparty : Counterparty
  operational : U (Bool)
  rehypothecated : Bool
  contract : Contract_Repo
  deriving DecidableEq, Repr, Inhabited

/-- Everything the rules read that is not computed here. -/
structure World where
  reporting_date : Int
  known_at : Int

def maturing (W : World) (m : Mode) (r : Repo) : Bool :=
  (match r.contract with
    | .REP maturity => (pcmp (· ≤ ·) (maturity - W.reporting_date) (30 : Int)))

def qualifies (W : World) (m : Mode) (r : Repo) : Bool :=
  (((r.collateral_class != HqlaClass.NonHqla) && (resolve m r.operational false (!false))) && (!((r.leg == Leg.Lending) && r.rehypothecated)))

def unwind (W : World) (m : Mode) (r : Repo) (k : HqlaClass) : Int :=
  (if (!((maturing W m r) && (qualifies W m r))) then (0 : Int) else (match r.leg with
    | .Funding => ((if (k == r.collateral_class) then r.collateral_value else (0 : Int)) - (if (k == HqlaClass.HQLA1) then r.cash else (0 : Int)))
    | .Lending => ((if (k == HqlaClass.HQLA1) then r.cash else (0 : Int)) - (if (k == r.collateral_class) then r.collateral_value else (0 : Int)))))

def row (W : World) (m : Mode) (r : Repo) : String :=
  (match r.leg with
    | .Funding => (match r.counterparty with
    | .OffshoreCentralBank => "11.7"
    | _ => (match r.collateral_class with
    | .HQLA1 => "11.1"
    | .HQLA2A => "11.2"
    | .RmbsHqla2B => "11.3"
    | .NonRmbsHqla2B => "11.4"
    | .NonHqla => (if (r.counterparty == Counterparty.DomesticSovereignOrPse) then "11.6.1" else "11.6.2")))
    | .Lending => (match r.collateral_class with
    | .HQLA1 => (if r.rehypothecated then "19.2.1" else "19.1.1")
    | .HQLA2A => (if r.rehypothecated then "19.2.2" else "19.1.2")
    | .RmbsHqla2B => (if r.rehypothecated then "19.2.3" else "19.1.3")
    | .NonRmbsHqla2B => (if r.rehypothecated then "19.2.4" else "19.1.4")
    | .NonHqla => (if r.rehypothecated then "19.2.6" else "19.1.8")))

def of_which_row (W : World) (m : Mode) (r : Repo) : String :=
  (match (r.leg, r.counterparty, r.collateral_class) with
    | (_, _, .NonHqla) => "none"
    | (.Funding, .OffshoreCentralBank, .HQLA1) => "11.7.1"
    | (.Funding, .OffshoreCentralBank, .HQLA2A) => "11.7.3"
    | (.Funding, .OffshoreCentralBank, .RmbsHqla2B) => "11.7.5"
    | (.Funding, .OffshoreCentralBank, .NonRmbsHqla2B) => "11.7.7"
    | _ => ((row W m r) ++ ".1"))

def collateral_row (W : World) (m : Mode) (r : Repo) : String :=
  (match (r.leg, r.counterparty, r.collateral_class) with
    | (_, _, .NonHqla) => "none"
    | (.Funding, .OffshoreCentralBank, .HQLA1) => "11.7.2"
    | (.Funding, .OffshoreCentralBank, .HQLA2A) => "11.7.4"
    | (.Funding, .OffshoreCentralBank, .RmbsHqla2B) => "11.7.6"
    | (.Funding, .OffshoreCentralBank, .NonRmbsHqla2B) => "11.7.8"
    | _ => ((row W m r) ++ ".2"))

def contribution (W : World) (m : Mode) (r : Repo) (i : String) : Int :=
  (if (!(maturing W m r)) then (0 : Int) else (((if (i == (row W m r)) then r.cash else (0 : Int)) + (if ((qualifies W m r) && (i == (of_which_row W m r))) then r.cash else (0 : Int))) + (if ((qualifies W m r) && (i == (collateral_row W m r))) then r.collateral_value else (0 : Int))))

